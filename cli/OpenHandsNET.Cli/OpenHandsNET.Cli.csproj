<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>openhandsnet</ToolCommandName>
    <PackageId>OpenHandsNET.Cli</PackageId>
    <Description>OpenHandsNET command line — device flow login, cloud conversations, headless CI runs, interactive TUI.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/OpenHandsNET.Eval/OpenHandsNET.Eval.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OpenHandsNET.UnitTests" />
  </ItemGroup>
</Project>
