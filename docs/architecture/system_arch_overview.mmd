    classDef runtime fill:#FFE4B5,stroke:#333,stroke-width:2px,color:black
    classDef external fill:#D3D3D3,stroke:#333,stroke-width:2px,color:black
    classDef eval fill:#FFB6C1,stroke:#DC143C,stroke-width:2px,color:black

    class WASM,CLI client
