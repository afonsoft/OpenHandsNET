@using Sandcastle.Client.Services
@implements IAsyncDisposable
@inject SandcastleApiClient Api
@inject MonacoInterop Monaco
@inject LocalizationService L

<div class="file-layout">
    <div class="file-tree">
        <div class="dir" @onclick="() => LoadAsync()"><Icon Name="folder" Size="13" /> /workspace</div>
        @foreach (var (entry, depth) in _flat)
        {
            <div class="@(entry.IsDirectory ? "dir" : "file")"
                 style="padding-left:@(8 + depth * 14)px"
                 @onclick="() => OnItemClick(entry)">
                @(entry.IsDirectory ? "▸" : "·") @Name(entry.Path)
            </div>
        }
    </div>
    <div class="file-view">
        @if (_filePath is null)
        {
            <div class="empty-state">@L["files.select_file"]</div>
        }
        else
        {
            <div class="diff-meta">
                @_filePath
                @* SPEC-147 RF-003: .md/.markdown ganham toggle
                   Rendered/Source (render sanitizado por MarkdownService). *@
                @if (IsMarkdown(_filePath))
                {
                    <span class="mode-toggle" style="float:right">
                        <button type="button" class="@(_rendered ? "sel" : "")"
                                @onclick="() => SetRenderedAsync(true)">
                            @L["files.rendered"]
                        </button>
                        <button type="button" class="@(!_rendered ? "sel" : "")"
                                @onclick="() => SetRenderedAsync(false)">
                            @L["files.source"]
                        </button>
                    </span>
                }
            </div>
            @* SPEC-21 RF-004: Monaco readonly; fallback <pre> sem JS.
               SPEC-147 RF-003: markdown renderizado e highlight de
               patch/diff nunca dependem do Monaco. *@
            @if (IsMarkdown(_filePath) && _rendered)
            {
                <div class="md">@MarkdownService.Render(_fileContent)</div>
            }
            else if (IsPatch(_filePath))
            {
                @* .patch/.diff com highlight de diff (mesmas classes
                   .diff-line do DiffTab — sem execução). *@
                <pre>@foreach (var line in DiffLines())
                {
                    <span class="diff-line @GitDiffRender.LineClass(line)">@line</span>
                }</pre>
            }
            else if (_monacoFailed)
            {
                <pre>@_fileContent</pre>
            }
            else
            {
                <div id="file-monaco" class="monaco-host"></div>
            }
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ConversationStateService State { get; set; } = default!;

    private readonly List<(FileItem Entry, int Depth)> _flat = [];
    private readonly HashSet<string> _expanded = [];
    private string? _filePath;
    private string? _fileContent;
    private bool _monacoFailed;
    private bool _monacoDirty;
    private bool _rendered = true;

    /// <summary>SPEC-147 RF-003: .md/.markdown renderizam no viewer.</summary>
    internal static bool IsMarkdown(string path) =>
        Path.GetExtension(path).ToLowerInvariant()
            is ".md" or ".markdown";

    /// <summary>SPEC-147 RF-003: .patch/.diff ganham highlight de diff.</summary>
    internal static bool IsPatch(string path) =>
        Path.GetExtension(path).ToLowerInvariant()
            is ".patch" or ".diff";

    /// <summary>Monaco só monta quando o host está na árvore.</summary>
    private bool ShowMonaco => _filePath is not null && !_monacoFailed
        && !(IsMarkdown(_filePath) && _rendered)
        && !IsPatch(_filePath);

    private IEnumerable<string> DiffLines() =>
        (_fileContent ?? "").Split('\n');

    private async Task SetRenderedAsync(bool rendered)
    {
        if (_rendered == rendered)
        {
            return;
        }

        _rendered = rendered;
        if (rendered)
        {
            try { await Monaco.DisposeAsync("file-monaco"); }
            catch (JSException) { /* best-effort — falha tolerada */ }
        }
        else
        {
            _monacoDirty = true;
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_monacoDirty && _filePath is not null && !_monacoFailed
            && ShowMonaco)
        {
            _monacoDirty = false;
            try
            {
                await Monaco.CreateEditorAsync("file-monaco",
                    _fileContent ?? "", MonacoInterop.LanguageFor(_filePath));
            }
            catch (JSException)
            {
                _monacoFailed = true;
                await InvokeAsync(StateHasChanged);
            }
            catch (InvalidOperationException)
            {
                _monacoFailed = true;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private static string Name(string path) =>
        path.TrimEnd('/').Split('/')[^1];

    private async Task LoadAsync()
    {
        try
        {
            var root = await Api.ListFilesAsync(State.Conversation!.Id);
            _flat.Clear();
            foreach (var f in root.OrderBy(f => f.Path))
            {
                _flat.Add((f, 0));
            }
        }
        catch { /* best-effort — falha tolerada */ }
    }

    private async Task OnItemClick(FileItem entry)
    {
        if (entry.IsDirectory)
        {
            if (!_expanded.Add(entry.Path))
            {
                _expanded.Remove(entry.Path);
                _flat.RemoveAll(f => f.Entry.Path.StartsWith(entry.Path + "/"));
                return;
            }

            var children = await Api.ListFilesAsync(
                State.Conversation!.Id, entry.Path);
            var insertAt = _flat.FindIndex(f => f.Entry.Path == entry.Path) + 1;
            var depth = _flat[insertAt - 1].Depth + 1;
            _flat.InsertRange(insertAt,
                children.OrderBy(c => c.Path).Select(c => (c, depth)));
        }
        else
        {
            _filePath = entry.Path;
            _rendered = true;
            _fileContent = "loading…";
            _monacoDirty = true;
            _fileContent = await Api.ReadFileAsync(
                State.Conversation!.Id, entry.Path);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Monaco.DisposeAsync("file-monaco");
        }
        catch (JSException) { /* circuito fechado */ }
        catch (JSDisconnectedException) { /* best-effort — falha tolerada */ }
    }
}
