@* SPEC-132 RF-004: user menu no footer da sidebar — avatar com iniciais,
   popover com theme switch, Settings, Admin condicional e Sign out.
   provider=none → chip "Local mode" (sem sessão a encerrar). *@
@using Sandcastle.Client.Services
@inject AuthStateService Auth
@inject ThemeService Theme
@inject DialogService Dialogs
@inject LocalizationService L
@inject NavigationManager Nav
@implements IDisposable

@* Sem sessão (RequiresAuth && !IsAuthenticated) → guard já levou a /auth. *@
@if (!Auth.RequiresAuth || Auth.IsAuthenticated)
{
    <div class="usermenu">
        <button class="avatar-btn" @onclick="() => _open = !_open"
                aria-haspopup="menu" aria-expanded="@_open"
                aria-label="@L["user_menu.aria"]"
                title="@MenuTitle()">
            <span class="avatar-initials" aria-hidden="true">@Initials()</span>
        </button>
        @if (_open)
        {
            <div class="usermenu-scrim" @onclick="() => _open = false"></div>
            <div class="menu usermenu-pop" role="menu"
                 aria-label="@L["user_menu.aria"]"
                 @onkeydown="OnMenuKey">
                <div class="usermenu-id">
                    <div class="usermenu-name">@DisplayName()</div>
                    <div class="usermenu-sub">@Subtitle()</div>
                </div>
                <div class="usermenu-theme" role="group"
                     aria-label="@L["theme.toggle"]">
                    @foreach (var t in Themes)
                    {
                        <button class="seg-btn @(Theme.Theme == t ? "on" : "")"
                                aria-pressed="@(Theme.Theme == t)"
                                title="@ThemeTitle(t)"
                                @onclick="() => SetThemeAsync(t)">
                            <Icon Name="@ThemeIcon(t)" Size="14" />
                        </button>
                    }
                </div>
                <div class="menu-sep" role="separator"></div>
                <button class="menu-item" role="menuitem"
                        @onclick="OpenSettingsAsync">
                    <Icon Name="settings" Size="13" /> @L["sidebar.settings"]
                </button>
                @if (Auth.User?.IsSuperAdmin == true)
                {
                    <a class="menu-item" role="menuitem" href="/admin">
                        <Icon Name="shield" Size="13" />
                        @L["sidebar.administration"]
                    </a>
                }
                @if (Auth.IsAuthenticated)
                {
                    <div class="menu-sep" role="separator"></div>
                    <button class="menu-item danger" role="menuitem"
                            @onclick="SignOutAsync">
                        <Icon Name="logout" Size="13" />
                        @L["user_menu.sign_out"]
                    </button>
                }
            </div>
        }
    </div>
}

@code {
    private static readonly string[] Themes =
        [ThemeService.Dark, ThemeService.Light, ThemeService.System];

    private bool _open;

    protected override void OnInitialized()
    {
        Auth.Changed += OnChanged;
        Theme.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private string Initials()
    {
        var name = DisplayName();
        var parts = name.Split(' ',
            StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => name[..Math.Min(2, name.Length)].ToUpperInvariant(),
            _ => string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant(),
        };
    }

    private string DisplayName() =>
        Auth.User?.DisplayName ?? Auth.User?.Email
            ?? L["user_menu.local_user"];

    private string Subtitle() =>
        Auth.IsAuthenticated
            ? Auth.User!.Email
            : L["user_menu.local_mode"];

    private string MenuTitle() => Auth.IsAuthenticated
        ? Auth.User!.Email
        : L["user_menu.local_mode"];

    private static string ThemeIcon(string theme) => theme switch
    {
        ThemeService.Light => "sun",
        ThemeService.System => "monitor",
        _ => "moon",
    };

    private string ThemeTitle(string theme) => theme switch
    {
        ThemeService.Light => L["settings.theme_light"],
        ThemeService.System => L["settings.theme_system"],
        _ => L["settings.theme_dark"],
    };

    private async Task SetThemeAsync(string theme)
    {
        await Theme.SetAsync(theme);
    }

    private async Task OpenSettingsAsync()
    {
        _open = false;
        await Dialogs.ShowSettingsAsync();
    }

    private async Task SignOutAsync()
    {
        _open = false;
        await Auth.LogoutAsync();
    }

    private void OnMenuKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _open = false;
        }
    }

    public void Dispose()
    {
        Auth.Changed -= OnChanged;
        Theme.Changed -= OnChanged;
    }
}
