@using Sandcastle.Client.Services
@using System.Text.Json
@inject SandcastleApiClient Api
@inject ThemeService Theme
@inject ChatNotificationsService ChatNotify
@inject ToastService Toasts
@inject LocalizationService L

@* SPEC-130 RF-002: conteúdo de settings compartilhado entre a página
   /settings (deep-link) e o SettingsModal (DialogService). *@
<div class="settings-layout">
        <nav class="settings-rail" role="tablist" aria-label="@L["settings.title"]">
            <button type="button" role="tab"
                    aria-selected="@(_tab == "general")"
                    class="settings-tab @(_tab == "general" ? "active" : "")"
                    @onclick='() => _tab = "general"'>
                @L["settings.appearance"]
            </button>
            <button type="button" role="tab"
                    aria-selected="@(_tab == "agent")"
                    class="settings-tab @(_tab == "agent" ? "active" : "")"
                    @onclick='() => _tab = "agent"'>
                @L["settings.agent_llm"]
            </button>
            <button type="button" role="tab"
                    aria-selected="@(_tab == "secrets")"
                    class="settings-tab @(_tab == "secrets" ? "active" : "")"
                    @onclick='() => _tab = "secrets"'>
                @L["settings.secrets"]
            </button>
            @* SPEC-147 RF-004/RF-005: abas Usage (budget) e Indexing. *@
            <button type="button" role="tab"
                    aria-selected="@(_tab == "usage")"
                    class="settings-tab @(_tab == "usage" ? "active" : "")"
                    @onclick='() => _tab = "usage"'>
                @L["settings.usage"]
            </button>
            <button type="button" role="tab"
                    aria-selected="@(_tab == "indexing")"
                    class="settings-tab @(_tab == "indexing" ? "active" : "")"
                    @onclick='() => _tab = "indexing"'>
                @L["settings.indexing"]
            </button>
            <a class="settings-tab settings-tab-link" href="/settings/skills">
                @L["skills.title"] →
            </a>
        </nav>

        <div class="settings-panel" role="tabpanel">
            @if (_tab == "general")
            {
                @* SPEC-26 RF-001: aparência — tema persiste local +
                   /users/me/preferences. *@
                <h3>@L["settings.appearance"]</h3>
                <div class="field">
                    <label>@L["settings.theme"]</label>
                    <select value="@Theme.Theme" @onchange="OnThemeChange"
                            aria-label="@L["settings.theme"]">
                        <option value="dark">@L["settings.theme_dark"]</option>
                        <option value="light">@L["settings.theme_light"]</option>
                        <option value="system">@L["settings.theme_system"]</option>
                    </select>
                </div>
                @* SPEC-46 RF-004: idioma — aplica imediato + localStorage +
                   merge em /users/me/preferences {locale}. *@
                <div class="field">
                    <label>@L["settings.language"]</label>
                    <select value="@L.Language" @onchange="OnLanguageChange"
                            aria-label="@(L["settings.language"])">
                        @foreach (var (lang, name) in L.Languages)
                        {
                            <option value="@lang">@(string.IsNullOrEmpty(name) ? lang : name)</option>
                        }
                    </select>
                </div>
                @* SPEC-116: paleta custom (themes/builtin.json). *@
                @if (Theme.Palettes.Count > 1)
                {
                    <div class="field">
                        <label>@L["settings.palette"]</label>
                        <select value="@Theme.PaletteId" @onchange="OnPaletteChange"
                                aria-label="@L["settings.palette"]">
                            @foreach (var p in Theme.Palettes)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>
                }
                @* SPEC-120 RF-006: notificação desktop opt-in (permissão
                   pedida só no gesto do toggle). *@
                <h3>@L["settings.notifications"]</h3>
                <label class="check">
                    <input type="checkbox" checked="@_notifyBrowser"
                           @onchange="OnNotifyBrowserChange"
                           aria-label="@L["settings.notify_browser"]" />
                    @L["settings.notify_browser"]
                </label>
                @* SPEC-147 RF-002: autoria de commits do agente —
                   persiste em /users/me/preferences (user-level da
                   cadeia user→org→global). *@
                <h3>@L["settings.git_author"]</h3>
                <div class="field">
                    <label>@L["settings.git_author_name"]</label>
                    <input aria-label="@L["settings.git_author_name"]"
                           placeholder="sandcastle-agent"
                           @bind="_gitAuthorName" @bind:event="oninput" />
                </div>
                <div class="field">
                    <label>@L["settings.git_author_email"]</label>
                    <input aria-label="@L["settings.git_author_email"]"
                           placeholder="agent@sandcastle.local"
                           @bind="_gitAuthorEmail" @bind:event="oninput" />
                </div>
                <label class="check">
                    <input type="checkbox" checked="@_gitCoauthor"
                           @onchange="e => _gitCoauthor = e.Value is true"
                           aria-label="@L["settings.git_coauthor"]" />
                    @L["settings.git_coauthor"]
                </label>
                <div class="row" style="display:flex;gap:8px;margin-top:8px">
                    <button @onclick="SaveGitAuthorAsync" disabled="@_gitSaving">
                        @L["common.save"]
                    </button>
                    @if (_gitSaved)
                    {
                        <span class="sub">@L["settings.saved"]</span>
                    }
                </div>
            }
            else if (_tab == "agent")
            {
                <h3>@L["settings.agent_llm"]</h3>
                <div class="field">
                    <label>@L["settings.llm_model"]</label>
                    <input aria-label="@L["settings.llm_model"]" @bind="_model" @bind:event="oninput" @bind:after="MarkDirty" />
                </div>
                <div class="field">
                    <label>@L["settings.llm_secret"]</label>
                    <input aria-label="@L["settings.llm_secret"]" @bind="_apiKeySecret" @bind:event="oninput" @bind:after="MarkDirty" />
                </div>
                <div class="field">
                    <label>@L["settings.agent_type"]</label>
                    <select aria-label="@L["settings.agent_type"]" value="@_agentType" @onchange="OnAgentTypeChange">
                        <option value="default">default</option>
                        <option value="plan">plan</option>
                        <option value="readonly">readonly</option>
                    </select>
                </div>
                @* SPEC-134 RF-005: BYOK — provider keys do usuário. *@
                <h4 class="llmkeys-title">@L["settings.llmkeys.title"]</h4>
                <p class="sub" style="color:var(--sc-fg-dim)">
                    @L["settings.llmkeys.hint"]
                </p>
                <div class="field">
                    <label>@L["settings.llmkeys.provider"]</label>
                    <select aria-label="@L["settings.llmkeys.provider"]"
                            value="@_lkProvider" @onchange="OnLkProviderChange">
                        @foreach (var p in _lkProviders)
                        {
                            <option value="@p.Id">@p.Label</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>@L["settings.llmkeys.key"]</label>
                    <input type="password" autocomplete="off"
                           aria-label="@L["settings.llmkeys.key"]"
                           placeholder="@L["settings.llmkeys.key_ph"]"
                           @bind="_lkKey" @bind:event="oninput" />
                </div>
                @if (_lkRequiresBaseUrl)
                {
                    <div class="field">
                        <label>@L["settings.llmkeys.base_url"]</label>
                        <input aria-label="@L["settings.llmkeys.base_url"]"
                               placeholder="https://…"
                               @bind="_lkBaseUrl" @bind:event="oninput" />
                    </div>
                }
                <div class="row" style="display:flex;gap:8px;margin-bottom:12px">
                    <button class="primary" @onclick="SaveLlmKeyAsync"
                            disabled="@(_lkBusy || string.IsNullOrWhiteSpace(_lkKey))">
                        @L["common.save"]
                    </button>
                </div>
                @if (_lkMessage is not null)
                {
                    <p class="llmkeys-msg @(_lkMessageOk ? "ok" : "err")">
                        @_lkMessage
                    </p>
                }
                @foreach (var k in _llmKeys)
                {
                    <div class="secret-row">
                        <span class="name">@k.Provider · @k.MaskedKey</span>
                        <button @onclick="() => TestLlmKeyAsync(k.Provider)"
                                disabled="@_lkBusy"
                                aria-label="@L.T("settings.llmkeys.test", ("provider", k.Provider))">
                            @L["settings.llmkeys.test_short"]
                        </button>
                        <button class="danger"
                                @onclick="() => DeleteLlmKeyAsync(k.Provider)"
                                disabled="@_lkBusy"
                                aria-label="@L.T("settings.llmkeys.remove", ("provider", k.Provider))">
                            @L["common.delete"]
                        </button>
                    </div>
                }
                @* RF-004: SettingsSaveBar — sticky, só com dirty-state. *@
                @if (_dirty)
                {
                    <div class="settings-savebar">
                        <span class="savebar-msg">@L["settings.unsaved"]</span>
                        <button type="button" class="settings-savebar-discard"
                                @onclick="DiscardSettings">
                            @L["common.discard"]
                        </button>
                        <button type="button" class="primary"
                                @onclick="SaveSettingsAsync" disabled="@_saving">
                            @(_saving ? L["settings.saving"] : L["settings.save"])
                        </button>
                    </div>
                }
            }
            else if (_tab == "usage")
            {
                @* SPEC-147 RF-004: "Your Budget" — limite mensal,
                   consumo do período, restante e breakdown por modelo. *@
                <h3>@L["usage.budget_title"]</h3>
                @if (_budget is null)
                {
                    <p class="sub">@L["common.loading"]</p>
                }
                else
                {
                    <p class="sub" style="color:var(--sc-fg-dim)">
                        @_budget.PeriodStart.ToString("d") – @_budget.PeriodEnd.ToString("d")
                    </p>
                    <div class="budget-bar" role="progressbar"
                         aria-label="@L["usage.consumed"]"
                         aria-valuemin="0" aria-valuemax="100"
                         aria-valuenow="@BudgetPct()">
                        <div class="budget-fill"
                             style="width:@BudgetPct()%"></div>
                    </div>
                    <p>
                        <strong>@FmtTokens(_budget.Consumed)</strong>
                        @L["usage.consumed"]
                        @if (_budget.MonthlyLimit is { } lim)
                        {
                            @:/ @FmtTokens(lim) @L["usage.limit"]
                        }
                        else
                        {
                            @:/ @L["usage.unlimited"]
                        }
                    </p>
                    @if (_budget.Remaining is { } rem)
                    {
                        <p>
                            <strong>@FmtTokens(rem)</strong>
                            @L["usage.remaining"]
                        </p>
                    }
                    @if (_budget.ByModel.Count > 0)
                    {
                        <h4>@L["usage.by_model"]</h4>
                        <table class="budget-models">
                            <thead>
                                <tr><th>@L["usage.model"]</th>
                                    <th>@L["usage.tokens"]</th>
                                    <th>@L["usage.cost"]</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var m in _budget.ByModel)
                                {
                                    <tr><td>@m.Model</td>
                                        <td>@FmtTokens(m.Tokens)</td>
                                        <td>$@m.CostUsd.ToString("0.0000")</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                    @* SPEC-149 RF-004: breakdown por role×model — mesma
                       fonte (TokenEvent) do card de budget. *@
                    @if (_llmUsage is { Rows.Count: > 0 })
                    {
                        <h4>@L["usage.by_role"]</h4>
                        <table class="budget-models">
                            <thead>
                                <tr><th>@L["usage.role"]</th>
                                    <th>@L["usage.model"]</th>
                                    <th>@L["usage.tokens"]</th>
                                    <th>@L["usage.cost"]</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var r in _llmUsage.Rows)
                                {
                                    <tr><td>@r.Role</td>
                                        <td>@r.Model</td>
                                        <td>@FmtTokens(r.Tokens)</td>
                                        <td>$@r.CostUsd.ToString("0.0000")</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                }
            }
            else if (_tab == "indexing")
            {
                @* SPEC-147 RF-005: status de indexação + trigger. *@
                <h3>@L["settings.indexing"]</h3>
                @if (_indexing is null)
                {
                    <p class="sub">@L["common.loading"]</p>
                }
                else
                {
                    <p>
                        <strong>@L.T("indexing.repos_indexed",
                            ("indexed", _indexing.Indexed.ToString()),
                            ("total", _indexing.TotalConnected.ToString()))</strong>
                        @if (_indexing.Indexing > 0)
                        {
                            <span class="meta">
                                · @_indexing.Indexing @L["indexing.indexing"]</span>
                        }
                        @if (_indexing.Failed > 0)
                        {
                            <span class="meta" style="color:var(--sc-red)">
                                · @_indexing.Failed @L["indexing.failed"]</span>
                        }
                    </p>
                }
                <div class="field">
                    <label>@L["indexing.repo"]</label>
                    <input aria-label="@L["indexing.repo"]"
                           placeholder="org/repo"
                           @bind="_idxRepo" @bind:event="oninput" />
                </div>
                <div class="field">
                    <label>@L["indexing.branch"]</label>
                    <input aria-label="@L["indexing.branch"]"
                           placeholder="main"
                           @bind="_idxBranch" @bind:event="oninput" />
                </div>
                <div class="row" style="display:flex;gap:8px">
                    <button @onclick="TriggerIndexAsync"
                            disabled="@(_idxBusy || string.IsNullOrWhiteSpace(_idxRepo))">
                        @L["indexing.trigger"]
                    </button>
                    @if (_idxTriggered)
                    {
                        <span class="sub">@L["indexing.triggered"]</span>
                    }
                </div>
            }
            else
            {
                <h3>@L["settings.secrets"]</h3>
                <p class="sub" style="color:var(--sc-fg-dim)">
                    @L["settings.secrets_hint"]
                </p>
                <div class="row" style="display:flex;gap:8px;margin-bottom:12px">
                    <input aria-label="@L["settings.secret_name"]" placeholder="@L["settings.secret_name"]" @bind="_secretName"
                           style="flex:1" />
                    <input aria-label="@L["settings.secret_value"]" placeholder="@L["settings.secret_value"]" type="password" @bind="_secretValue"
                           style="flex:2" />
                    <button @onclick="AddSecretAsync"
                            disabled="@(string.IsNullOrWhiteSpace(_secretName) || string.IsNullOrWhiteSpace(_secretValue))">
                        @L["common.add"]
                    </button>
                </div>
                @foreach (var name in _secrets)
                {
                    <div class="secret-row">
                        <span class="name">@name</span>
                        <button class="danger" @onclick="() => DeleteSecretAsync(name)">@L["common.delete"]</button>
                    </div>
                }
            }
        </div>
    </div>
@code {
    /// <summary>SPEC-147: aba inicial (deep-link <c>/settings?tab=…</c>).</summary>
    [Parameter] public string? InitialTab { get; set; }

    private string _tab = "general";
    private string _gitAuthorName = "";
    private string _gitAuthorEmail = "";
    private bool _gitCoauthor = true;
    private bool _gitSaving;
    private bool _gitSaved;
    private UsageBudgetDto? _budget;
    private LlmUsageBreakdownDto? _llmUsage; // SPEC-149
    private IndexingStatusDto? _indexing;
    private string _idxRepo = "";
    private string _idxBranch = "";
    private bool _idxBusy;
    private bool _idxTriggered;
    private string _model = "";
    private string _apiKeySecret = "";
    private string _agentType = "default";
    private bool _saving, _dirty;
    private string _savedModel = "";
    private string _savedSecret = "";
    private string _savedAgentType = "default";
    private string _secretName = "";
    private string _secretValue = "";
    private bool _notifyBrowser;
    private List<string> _secrets = [];
    private List<SandcastleApiClient.UserLlmKeyInfoDto> _llmKeys = [];
    private List<LkProvider> _lkProviders = [];
    private string _lkProvider = "openai";
    private string _lkKey = "";
    private string _lkBaseUrl = "";
    private bool _lkBusy;
    private bool _lkRequiresBaseUrl;
    private string? _lkMessage;
    private bool _lkMessageOk;

    private sealed record LkProvider(
        string Id, string Label, bool RequiresBaseUrl);

    protected override async Task OnInitializedAsync()
    {
        if (InitialTab is "general" or "agent" or "secrets"
            or "usage" or "indexing")
        {
            _tab = InitialTab;
        }

        await Theme.LoadPalettesAsync();
        _notifyBrowser = await ChatNotify.GetPrefAsync();
        try
        {
            var s = await Api.GetSettingsAsync();
            if (s.ValueKind == JsonValueKind.Object)
            {
                _model = _savedModel = GetStr(s, "llm_model") ?? "";
                _apiKeySecret = _savedSecret =
                    GetStr(s, "llm_api_key_secret") ?? "";
                _agentType = _savedAgentType =
                    GetStr(s, "agent_type") ?? "default";
            }
        }
        catch { /* best-effort — falha tolerada */ }
        try { _secrets = (await Api.ListSecretsAsync()).ToList(); }
        catch { /* best-effort — falha tolerada */ }
        await LoadLlmKeysAsync();

        // SPEC-147: budgets/indexing/git-author — cada um best-effort.
        try { _budget = await Api.GetUsageBudgetAsync(); } catch { }
        try { _llmUsage = await Api.GetLlmUsageByRoleAsync(); } catch { } // SPEC-149
        try { _indexing = await Api.GetIndexingStatusAsync(); } catch { }
        try
        {
            var prefs = await Api.GetPreferencesAsync();
            _gitAuthorName = prefs.GetValueOrDefault("git_author_name") ?? "";
            _gitAuthorEmail = prefs.GetValueOrDefault("git_author_email") ?? "";
            _gitCoauthor = prefs.GetValueOrDefault("git_coauthor") is not "false";
        }
        catch { /* preferências opcionais */ }
    }

    private async Task LoadLlmKeysAsync()
    {
        try
        {
            var providers = await Api.ListLlmKeyProvidersAsync();
            _lkProviders = providers.Select(e => new LkProvider(
                    e.TryGetProperty("id", out var i) ? i.GetString() ?? "" : "",
                    e.TryGetProperty("label", out var l) ? l.GetString() ?? "" : "",
                    e.TryGetProperty("requires_base_url", out var r)
                        && r.GetBoolean()))
                .Where(p => p.Id.Length > 0).ToList();
            if (_lkProviders.Count == 0)
            {
                _lkProviders = [new LkProvider("openai", "OpenAI", false)];
            }

            _lkProvider = _lkProviders[0].Id;
            _lkRequiresBaseUrl = _lkProviders[0].RequiresBaseUrl;
            _llmKeys = (await Api.ListLlmKeysAsync()).ToList();
        }
        catch { /* BYOK opcional — falha tolerada */ }
    }

    private void OnLkProviderChange(ChangeEventArgs e)
    {
        _lkProvider = e.Value?.ToString() ?? "openai";
        _lkRequiresBaseUrl = _lkProviders
            .FirstOrDefault(p => p.Id == _lkProvider)?.RequiresBaseUrl
            ?? false;
        _lkMessage = null;
    }

    private async Task SaveLlmKeyAsync()
    {
        _lkBusy = true;
        _lkMessage = null;
        try
        {
            await Api.PutLlmKeyAsync(_lkProvider, _lkKey.Trim(),
                string.IsNullOrWhiteSpace(_lkBaseUrl) ? null : _lkBaseUrl.Trim());
            _lkKey = "";
            _lkBaseUrl = "";
            _llmKeys = (await Api.ListLlmKeysAsync()).ToList();
            _lkMessageOk = true;
            _lkMessage = L["settings.llmkeys.saved"];
        }
        catch (HttpRequestException)
        {
            _lkMessageOk = false;
            _lkMessage = L["settings.llmkeys.err"];
        }
        finally { _lkBusy = false; }
    }

    private async Task DeleteLlmKeyAsync(string provider)
    {
        _lkBusy = true;
        _lkMessage = null;
        try
        {
            await Api.DeleteLlmKeyAsync(provider);
            _llmKeys = _llmKeys.Where(k => k.Provider != provider).ToList();
        }
        catch (HttpRequestException)
        {
            _lkMessageOk = false;
            _lkMessage = L["settings.llmkeys.err"];
        }
        finally { _lkBusy = false; }
    }

    private async Task TestLlmKeyAsync(string provider)
    {
        _lkBusy = true;
        _lkMessage = null;
        try
        {
            var (ok, detail) = await Api.TestLlmKeyAsync(provider);
            _lkMessageOk = ok;
            _lkMessage = ok
                ? L.T("settings.llmkeys.test_ok", ("provider", provider))
                : L.T("settings.llmkeys.test_fail",
                    ("provider", provider), ("detail", detail ?? "?"));
        }
        catch (HttpRequestException)
        {
            _lkMessageOk = false;
            _lkMessage = L["settings.llmkeys.err"];
        }
        finally { _lkBusy = false; }
    }

    private static string? GetStr(JsonElement el, string name) =>
        el.TryGetProperty(name, out var v) ? v.GetString() : null;

    private void MarkDirty() => _dirty = true;

    private void OnAgentTypeChange(ChangeEventArgs e)
    {
        _agentType = e.Value?.ToString() ?? "default";
        MarkDirty();
    }

    /// <summary>RF-004: descarta — volta aos valores do último save.</summary>
    private void DiscardSettings()
    {
        _model = _savedModel;
        _apiKeySecret = _savedSecret;
        _agentType = _savedAgentType;
        _dirty = false;
    }

    private async Task SaveSettingsAsync()
    {
        _saving = true;
        try
        {
            var doc = JsonSerializer.SerializeToElement(new
            {
                llm_model = _model,
                llm_api_key_secret = _apiKeySecret,
                agent_type = _agentType,
            });
            await Api.SaveSettingsAsync(doc);
            _savedModel = _model;
            _savedSecret = _apiKeySecret;
            _savedAgentType = _agentType;
            _dirty = false;
            Toasts.Success(L["settings.saved"]);
        }
        finally { _saving = false; }
    }

    private async Task AddSecretAsync()
    {
        await Api.PutSecretAsync(_secretName.Trim(), _secretValue);
        _secrets.Add(_secretName.Trim());
        _secretName = "";
        _secretValue = "";
    }

    private async Task DeleteSecretAsync(string name)
    {
        await Api.DeleteSecretAsync(name);
        _secrets.Remove(name);
    }

    /// <summary>SPEC-26: troca de tema — persiste local + remoto, toast.</summary>
    private async Task OnThemeChange(ChangeEventArgs e)
    {
        await Theme.SetAsync(e.Value?.ToString() ?? ThemeService.Light);
        Toasts.Success(L.T("settings.theme_toast", ("theme", Theme.Theme)));
    }

    private async Task OnPaletteChange(ChangeEventArgs e) =>
        await Theme.SetPaletteAsync(e.Value?.ToString() ?? "default");

    /// <summary>SPEC-120 RF-006: opt-in — permissão pedida só neste
    /// gesto; se o navegador negar, o toggle volta desligado.</summary>
    private async Task OnNotifyBrowserChange(ChangeEventArgs e)
    {
        var wanted = e.Value is true;
        _notifyBrowser = wanted && await ChatNotify.SetPrefAsync(true);
        if (wanted && !_notifyBrowser)
        {
            Toasts.Error(L["settings.notify_denied"]);
        }
    }

    /// <summary>SPEC-46 RF-004: idioma — L.SetLanguageAsync aplica sem
    /// reload (Changed → MainLayout re-renderiza); persistência remota
    /// best-effort no dict de preferences.</summary>
    private async Task OnLanguageChange(ChangeEventArgs e)
    {
        var code = e.Value?.ToString() ?? LocalizationService.DefaultLanguage;
        await L.SetLanguageAsync(code);
        try
        {
            await Api.PutPreferencesAsync(
                new Dictionary<string, string> { ["locale"] = code });
        }
        catch { /* remoto best-effort — localStorage já persistiu */ }
    }

    // ---- SPEC-147 ---------------------------------------------------------

    /// <summary>RF-002: salva git_author_* em /users/me/preferences.</summary>
    private async Task SaveGitAuthorAsync()
    {
        _gitSaving = true;
        _gitSaved = false;
        try
        {
            var prefs = new Dictionary<string, string>
            {
                ["git_author_name"] = _gitAuthorName.Trim(),
                ["git_author_email"] = _gitAuthorEmail.Trim(),
                ["git_coauthor"] = _gitCoauthor ? "true" : "false",
            };
            await Api.PutPreferencesAsync(prefs);
            _gitSaved = true;
        }
        catch { _gitSaved = false; }
        finally { _gitSaving = false; }
    }

    /// <summary>RF-005: dispara indexação manual do repo informado.</summary>
    private async Task TriggerIndexAsync()
    {
        _idxBusy = true;
        _idxTriggered = false;
        try
        {
            _idxTriggered = await Api.TriggerRepoIndexAsync(
                _idxRepo.Trim(),
                string.IsNullOrWhiteSpace(_idxBranch) ? null : _idxBranch.Trim());
            if (_idxTriggered)
            {
                // Reconta — o agregado passa a refletir "indexing".
                _indexing = await Api.GetIndexingStatusAsync();
            }
        }
        catch { _idxTriggered = false; }
        finally { _idxBusy = false; }
    }

    /// <summary>Percentual consumido do limite (0–100; ilimitado → 0).</summary>
    private int BudgetPct()
    {
        if (_budget is null || _budget.MonthlyLimit is not { } lim
            || lim <= 0)
        {
            return 0;
        }

        return (int)Math.Min(100,
            Math.Max(0, _budget.Consumed * 100 / lim));
    }

    /// <summary>Formata tokens com sufixo k/M para o card.</summary>
    private static string FmtTokens(long tokens) => tokens switch
    {
        >= 1_000_000 => $"{tokens / 1_000_000.0:0.##}M",
        >= 1_000 => $"{tokens / 1_000.0:0.#}k",
        _ => tokens.ToString(),
    };
}
