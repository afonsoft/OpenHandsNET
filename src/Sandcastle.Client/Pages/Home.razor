@page "/"
@using Sandcastle.Client.Services
@inject SandcastleApiClient Api
@inject LocalizationService L
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Sandcastle</PageTitle>

<div class="home-wrap">
    <h1>Sandcastle</h1>
    <p class="sub">@L["home.subtitle"]</p>

    <div class="new-conv">
        <ChatComposer Placeholder="@L["composer.placeholder_new"]"
                      DraftKey="new" OnSend="OnComposerSendAsync" />
        <div class="row">
            <input aria-label="@L["home.repository_placeholder"]" placeholder="@L["home.repository_placeholder"]"
                   @bind="_repository" @bind:event="oninput"
                   @onkeydown="OnRepoKeyDownAsync" />
            <button aria-label="@L["home.repo_add"]" title="@L["home.repo_add"]"
                    @onclick="AddRepoAsync"
                    disabled="@(_repositories.Count >= 4 || string.IsNullOrWhiteSpace(_repository))">
                +
            </button>
            <label title="@L["home.confirm_title"]">
                <input type="checkbox" @bind="_confirmMode" /> @L["home.confirmation"]
            </label>
            <button class="primary" @onclick="StartAsync" disabled="@_starting">
                @(_starting ? L["home.starting"] : L["home.run"])
            </button>
        </div>
        @* SPEC-146 RF-001/RF-010: chips multi-repo — índice 0 = primário. *@
        @if (_repositories.Count > 0)
        {
            <div class="row repo-chips" role="list" aria-label="@L["home.repositories"]">
                @for (var i = 0; i < _repositories.Count; i++)
                {
                    var idx = i;
                    var chipClass = idx == 0 ? "chip mention" : "chip";
                    <span class="@chipClass" role="listitem"
                          title="@(idx == 0 ? L["home.repo_primary"] : "")">
                        @(idx == 0 ? "★ " : "")@_repositories[idx]
                        <button class="chip-x"
                                aria-label="@L.T("home.repo_remove", ("repo", _repositories[idx]))"
                                @onclick="() => RemoveRepo(idx)">×</button>
                    </span>
                }
            </div>
        }
        @* SPEC-147 RF-005: badge "X/Y repos indexed" + link p/ gerenciar. *@
        @if (_indexing is not null)
        {
            <div class="row index-badge-row">
                <a class="index-badge" href="/settings?tab=indexing">
                    @L.T("indexing.repos_indexed",
                        ("indexed", _indexing.Indexed.ToString()),
                        ("total", _indexing.TotalConnected.ToString()))
                    @if (_indexing.Indexing > 0)
                    {
                        <span class="meta">· @_indexing.Indexing @L["indexing.indexing"]</span>
                    }
                    @if (_indexing.Failed > 0)
                    {
                        <span class="meta" style="color:var(--sc-red)">· @_indexing.Failed @L["indexing.failed"]</span>
                    }
                </a>
            </div>
        }
        @if (_progress.Count > 0)
        {
            <div class="start-progress">
                @foreach (var (status, active) in _progress)
                {
                    <div class="step @(active ? "active" : "done")">
                        @(active ? "▸" : "✓") @status
                    </div>
                }
            </div>
        }
        @if (_error is not null)
        {
            <div class="start-progress"><div class="step" style="color:var(--sc-red)">@_error</div></div>
        }
    </div>

    <div class="conv-list">
        @if (_conversations is null)
        {
            <p class="sub">@L["common.loading"]</p>
        }
        else if (_conversations.Count == 0)
        {
            <p class="sub">@L["home.empty"]</p>
        }
        else
        {
            @foreach (var c in _conversations)
            {
                <a class="conv-card" href="/conversations/@c.Id">
                    <span class="badge @BadgeClass(c.ExecutionStatus)">
                        <span class="dot"></span>@c.ExecutionStatus
                    </span>
                    <span class="title">@(c.Title ?? L["conversation.untitled"])</span>
                    <span class="meta">@RepoLabel(c)</span>
                    <span class="meta">@c.UpdatedAt.LocalDateTime.ToString("g")</span>
                </a>
            }
        }
    </div>
</div>

@code {
    private IReadOnlyList<ConversationItem>? _conversations;
    private IndexingStatusDto? _indexing;
    private string _initialMessage = "";
    private string _repository = "";
    /// <summary>SPEC-146: seleção multi-repo (máx 4; índice 0 = primário).</summary>
    private readonly List<string> _repositories = [];
    private bool _confirmMode;
    private bool _starting;
    private string? _error;
    private readonly List<(string Status, bool Active)> _progress = [];
    private readonly string[] _pipeline =
        ["WORKING", "SETTING_UP_WORKSPACE", "SETTING_UP_GIT", "SETTING_UP_SKILLS", "READY"];
    private System.Timers.Timer? _poll;

    protected override async Task OnInitializedAsync()
    {
        try { _conversations = await Api.ListConversationsAsync(); }
        catch { _conversations = []; }
        try { _indexing = await Api.GetIndexingStatusAsync(); }
        catch { /* badge best-effort — sem status, sem badge */ }
    }

    private static string BadgeClass(string status) =>
        "badge " + status.ToLowerInvariant().Replace(' ', '_');

    /// <summary>
    /// SPEC-146: adiciona repo como chip (Enter) — max 4, sem duplicata
    /// case-insensitive; primeiro chip = primário.
    /// </summary>
    private Task AddRepoAsync()
    {
        var name = _repository.Trim().TrimEnd('/');
        if (name.Length > 0 && _repositories.Count < 4
            && !_repositories.Any(r => string.Equals(
                r, name, StringComparison.OrdinalIgnoreCase)))
        {
            _repositories.Add(name);
            _repository = "";
            _error = null;
        }

        return Task.CompletedTask;
    }

    private Task OnRepoKeyDownAsync(KeyboardEventArgs e) =>
        e.Key is "Enter" or ";" or "," ? AddRepoAsync() : Task.CompletedTask;

    private void RemoveRepo(int index)
    {
        if (index >= 0 && index < _repositories.Count)
        {
            _repositories.RemoveAt(index);
        }
    }

    /// <summary>SPEC-146: label do card — repos ordenados ou legado.</summary>
    private static string RepoLabel(ConversationItem c) =>
        c.Repositories is { Count: > 0 } r
            ? string.Join(", ", r)
            : c.SelectedRepository ?? "";

    /// <summary>SPEC-45: composer da Home — envio inicia a conversa.</summary>
    private async Task OnComposerSendAsync(string text)
    {
        _initialMessage = text;
        await StartAsync();
    }

    private async Task StartAsync()
    {
        _starting = true;
        _error = null;
        _progress.Clear();
        try
        {
            // Chips têm precedência; texto livre vira repo único
            // (retrocompat SPEC-12).
            IReadOnlyList<string>? repos = _repositories.Count > 0
                ? _repositories.ToArray()
                : string.IsNullOrWhiteSpace(_repository)
                    ? null
                    : [_repository.Trim()];
            var task = await Api.CreateConversationAsync(
                string.IsNullOrWhiteSpace(_initialMessage) ? null : _initialMessage,
                repos?[0],
                run: true, confirmationMode: _confirmMode,
                repositories: repos);
            TrackStatus(task.Status);
            _poll = new System.Timers.Timer(1200);
            _poll.Elapsed += async (_, _) => await PollTaskAsync(task.Id);
            _poll.AutoReset = true;
            _poll.Start();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _starting = false;
        }
    }

    private async Task PollTaskAsync(string taskId)
    {
        try
        {
            var t = await Api.GetStartTaskAsync(taskId);
            if (t is null) { return; }
            await InvokeAsync(() => { TrackStatus(t.Status); StateHasChanged(); });
            if (t.Status is "READY")
            {
                _poll?.Stop();
                Nav.NavigateTo($"/conversations/{t.AppConversationId}");
            }
            else if (t.Status is "ERROR")
            {
                _poll?.Stop();
                await InvokeAsync(() =>
                {
                    _error = t.Detail ?? L["home.start_failed"];
                    _starting = false;
                    StateHasChanged();
                });
            }
        }
        catch { /* retry no próximo tick */ }
    }

    private void TrackStatus(string status)
    {
        var idx = Array.IndexOf(_pipeline, status);
        for (var i = 0; i < _progress.Count; i++)
        {
            _progress[i] = (_progress[i].Status, false);
        }

        for (var i = 0; i <= idx && i < _pipeline.Length; i++)
        {
            if (_progress.All(p => p.Status != _pipeline[i]))
            {
                _progress.Add((_pipeline[i], i == idx && status != "READY"));
            }
        }
    }

    public void Dispose() => _poll?.Dispose();
}
