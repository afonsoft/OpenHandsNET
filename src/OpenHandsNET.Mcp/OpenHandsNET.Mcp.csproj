<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OpenHandsNET.Mcp — servidor MCP (Model Context Protocol) stdio que
    expõe o produto como ferramenta para agentes externos (SPEC-124
    RF-001). Análogo ao OpenWebUI.Mcp do fork irmão: processo filho do
    cliente MCP falando HTTP com o OpenHandsNET.Api — nenhum caminho
    novo de execução no servidor.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>openhandsnet-mcp</AssemblyName>
    <RootNamespace>OpenHandsNET.Mcp</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- stdout é protocolo — nada de logging nele -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
