@page "/conversations/{Id}"
@using OpenHandsNET.Client.Services
@using OpenHandsNET.Client.Components.Conversation
@inject ConversationStateService State
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject OpenHandsNetApiClient Api
@inject ToastService Toasts
@implements IAsyncDisposable

<PageTitle>@(State.Conversation?.Title ?? "conversation") · OpenHandsNET</PageTitle>

<div class="conv-page">
    <div class="topbar">
        <a href="/" class="icon-btn" title="back" aria-label="Back">
            <Icon Name="chevron-left" Size="16" />
        </a>
        <span class="title">@(State.Conversation?.Title ?? "loading…")</span>
        @if (State.Conversation?.SelectedRepository is { } repo)
        {
            <span class="repo"><Icon Name="git-branch" Size="13" /> @repo</span>
        }
        <ModelSelector Current="@State.Conversation?.LlmModel"
                       OnSwitch="OnModelSwitch" />
        <AgentModeToggle Mode="@State.Conversation?.Mode"
                         OnSwitch="OnModeSwitch" />
        <span class="spacer"></span>
        @if (_surfaces.Any(s => s.Name == "terminal" && s.Url is not null))
        {
            <button class="icon-btn" title="Terminal (nova aba)"
                    aria-label="Open terminal"
                    @onclick='() => OpenSurfaceAsync("terminal")'>
                <Icon Name="terminal" Size="15" />
            </button>
        }
        @if (_surfaces.Any(s => s.Name == "vscode" && s.Url is not null))
        {
            <button class="icon-btn" title="Open in editor (nova aba)"
                    aria-label="Open in editor"
                    @onclick='() => OpenSurfaceAsync("vscode")'>
                <Icon Name="code" Size="15" />
            </button>
        }
        <span class="tokens">@(State.PromptTokens + State.CompletionTokens) tok ·
            $@State.CostUsd.ToString("F4")</span>
        <span class="badge @BadgeClass(State.ExecutionStatus)">
            <span class="dot"></span>@State.ExecutionStatus
        </span>
        <span class="badge @(State.Connected ? "running" : "stopped")"
              title="hub connection">
            <span class="dot"></span>@(State.Connected ? "live" : "offline")
        </span>
    </div>

    <div class="panes" id="conv-panes">
        <div class="pane-left">
            <ChatPane State="State" />
            <PlannerPane State="State" />
        </div>
        <div class="pane-divider"></div>
        <div class="pane-right">
            <div class="tab-bar" role="tablist">
                @foreach (var (tab, label) in _tabs)
                {
                    <button role="tab" aria-selected="@(_tab == tab)"
                            class="@(_tab == tab ? "active" : "")"
                            @onclick="() => _tab = tab">@label</button>
                }
            </div>
            <div class="tab-body" role="tabpanel">
                @if (_tab == "ide")
                {
                    @* SPEC-42 RF-002: workbench IDE na ordem
                       chat | ide | terminal | … *@
                    <IdeTab State="State" />
                }
                else if (_tab == "terminal")
                {
                    <TerminalTab State="State" />
                }
                else if (_tab == "browser")
                {
                    <BrowserTab State="State" />
                }
                else if (_tab == "files")
                {
                    <FilesTab State="State" />
                }
                else if (_tab == "diff")
                {
                    <DiffTab State="State" />
                }
                else if (_tab == "commits")
                {
                    <CommitsTab State="State" />
                }
                else
                {
                    <UsageTab State="State" />
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Id { get; set; } = "";

    private string _tab = "terminal";
    private IReadOnlyList<OpenHandsNetApiClient.SurfaceItem> _surfaces = [];

    private static readonly (string Tab, string Label)[] _tabs =
    [
        ("ide", "IDE"),
        ("terminal", "Terminal"), ("browser", "Browser"), ("files", "Files"),
        ("diff", "Diff"), ("commits", "Commits"), ("usage", "Usage"),
    ];

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        await State.OpenAsync(Id);
        _ = RefreshSurfacesAsync();
    }

    /// <summary>
    /// SPEC-40 RF-002/003: surfaces ativas do sandbox — ícones do topbar
    /// só aparecem quando a surface tem URL pública (routing != internal).
    /// </summary>
    private async Task RefreshSurfacesAsync()
    {
        try
        {
            _surfaces = await Api.GetSurfacesAsync(Id);
            await InvokeAsync(StateHasChanged);
        }
        catch { /* surfaces off/unreachable → ícones ocultos */ }
    }

    /// <summary>Abre a surface em nova aba com preview token fresco.</summary>
    private async Task OpenSurfaceAsync(string name)
    {
        try
        {
            // Refetch: o token HMAC expira em ~15min — a URL cacheada
            // pode estar vencida.
            _surfaces = await Api.GetSurfacesAsync(Id);
            var s = _surfaces.FirstOrDefault(
                x => x.Name == name && x.Url is not null);
            if (s?.Url is { } url)
            {
                await JS.InvokeVoidAsync("open", url, "_blank");
            }
            else
            {
                Toasts.Info($"surface '{name}' indisponível");
            }
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error($"surfaces falhou: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("ohnSplit.init", "conv-panes", Id);
        }
    }

    private async void OnChanged()
    {
        try { await InvokeAsync(StateHasChanged); }
        catch { }
    }

    /// <summary>SPEC-26: troca de modelo — vale a partir do próximo run.</summary>
    private async Task OnModelSwitch(string model)
    {
        try
        {
            await Api.SwitchModelAsync(Id, model);
            Toasts.Success($"modelo → {model}");
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error($"troca de modelo falhou: {ex.Message}");
        }
    }

    /// <summary>SPEC-26/29: overlay plan|build.</summary>
    private async Task OnModeSwitch(string mode)
    {
        try
        {
            await Api.SetModeAsync(Id, mode);
            Toasts.Success($"modo → {mode}");
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error($"troca de modo falhou: {ex.Message}");
        }
    }

    private static string BadgeClass(string status) =>
        "badge " + status.ToLowerInvariant().Replace(' ', '_');

    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnChanged;
        await State.DisposeAsync();
    }
}
