@page "/admin/repos"
@using OpenHandsNET.Client.Services
@inject OpenHandsNetApiClient Api
@inject LocalizationService L

<PageTitle>@L["admin.nav_repos"] — OpenHandsNET</PageTitle>

<h2>@L["admin.repos_title"]</h2>

<div class="admin-repos">
    <div class="row">
        <input placeholder="owner/repo" @bind="_repo" @bind:event="oninput" />
        <input placeholder="main" @bind="_branch" @bind:event="oninput" />
        <button class="primary" @onclick="AddAsync"
                disabled="@(_busy || string.IsNullOrWhiteSpace(_repo))">
            @L["admin.repos_add"]
        </button>
    </div>

    @if (_items is null)
    {
        <p class="sub">@L["common.loading"]</p>
    }
    else if (_items.Count == 0)
    {
        <p class="sub">@L["admin.repos_empty"]</p>
    }
    else
    {
        <table class="tbl">
            <thead><tr>
                <th>@L["admin.repos_repo"]</th><th>@L["admin.repos_branch"]</th>
                <th>@L["admin.repos_status"]</th><th>@L["admin.repos_units"]</th>
                <th>@L["admin.repos_indexed"]</th><th></th>
            </tr></thead>
            <tbody>
                @foreach (var r in _items)
                {
                    <tr>
                        <td>@r.Repository</td><td>@r.Branch</td>
                        <td><span class="badge @r.Status.ToLowerInvariant()">@r.Status</span></td>
                        <td>@r.UnitCount</td>
                        <td>@(r.IndexedAt?.LocalDateTime.ToString("g") ?? "—")</td>
                        <td>
                            <button @onclick="() => ReindexAsync(r.Id)">
                                @L["admin.repos_reindex"]
                            </button>
                            <button class="danger"
                                    @onclick="() => DeleteAsync(r.Id)">
                                @L["common.delete"]
                            </button>
                        </td>
                    </tr>
                    @if (r.Error is not null)
                    {
                        <tr><td colspan="6" class="err">@r.Error</td></tr>
                    }
                }
            </tbody>
        </table>
    }
</div>

@code {
    private IReadOnlyList<RepoIndexItem>? _items;
    private string _repo = "";
    private string _branch = "main";
    private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
        => _items = await Api.ListRepoIndexesAsync();

    private async Task AddAsync()
    {
        _busy = true;
        var branch = string.IsNullOrWhiteSpace(_branch) ? null : _branch;
        await Api.AddRepoIndexAsync(_repo.Trim(), branch);
        _repo = "";
        await LoadAsync();
        _busy = false;
    }

    private async Task ReindexAsync(Guid id)
    {
        await Api.ReindexRepoAsync(id);
        await LoadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        await Api.DeleteRepoIndexAsync(id);
        await LoadAsync();
    }
}
