@page "/admin/audit"
@using OpenHandsNET.Client.Services
@using System.Text.Json
@inherits AdminPageBase

<PageTitle>admin · audit</PageTitle>

@if (Checking || !Allowed)
{
    <div class="settings-wrap"><p class="empty-state">…</p></div>
}
else
{
    <div class="settings-wrap admin-wrap">
        <h1>Audit <span class="sub">(@_total eventos)</span></h1>
        <AdminNav />
        @if (Error is not null) { <p class="admin-error">@Error</p> }

        <div class="field admin-toolbar">
            <input placeholder="user id…" @bind="_user" @bind:event="oninput" />
            <input placeholder="action…" @bind="_action" @bind:event="oninput" />
            <button @onclick="() => LoadPageAsync(1)">Filter</button>
            <a class="badge" download
               href="@AdminApiClient.AuditCsvUrl(_user, _action, _from, _to)">
                ↓ csv
            </a>
        </div>
        <div class="field admin-toolbar">
            <label>from <input type="date" @bind="_fromDate" /></label>
            <label>to <input type="date" @bind="_toDate" /></label>
        </div>

        @foreach (var e in _items)
        {
            <div class="secret-row">
                <span>@Ts(e)</span>
                <span class="name">@Str(e, "action")</span>
                <span>@Str(e, "actor_user_id")</span>
                <span>@Str(e, "target_type"):@Str(e, "target_id")</span>
            </div>
        }
        @if (_items.Count == 0)
        {
            <p class="empty-state">no audit events</p>
        }

        <div class="admin-pager">
            <button disabled="@(_page <= 1)"
                    @onclick="() => LoadPageAsync(_page - 1)">‹ prev</button>
            <span>page @_page</span>
            <button disabled="@((_page * 100) >= _total)"
                    @onclick="() => LoadPageAsync(_page + 1)">next ›</button>
        </div>
    </div>
}

@code {
    private IReadOnlyList<JsonElement> _items = [];
    private string? _user;
    private string? _action;
    private DateTime _fromDate;
    private DateTime _toDate;
    private int _page = 1;
    private int _total;

    private DateTimeOffset? _from => _fromDate == default
        ? null : new DateTimeOffset(_fromDate, TimeSpan.Zero);
    private DateTimeOffset? _to => _toDate == default
        ? null : new DateTimeOffset(_toDate.AddDays(1), TimeSpan.Zero);

    protected override async Task LoadAsync() => await LoadPageAsync(1);

    private async Task LoadPageAsync(int page)
    {
        _page = page;
        (_items, _total) = await Api.QueryAuditAsync(
            _user, _action, _from, _to, page);
    }

    private static string? Str(JsonElement e, string prop) =>
        e.TryGetProperty(prop, out var v) && v.ValueKind
            is JsonValueKind.String ? v.GetString() : null;

    private static string Ts(JsonElement e)
    {
        var s = Str(e, "timestamp") ?? "";
        return s.Length > 19 ? s[..19].Replace('T', ' ') : s;
    }
}
