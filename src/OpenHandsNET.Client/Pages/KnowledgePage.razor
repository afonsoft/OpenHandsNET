@page "/knowledge"
@using OpenHandsNET.Client.Services
@inject OpenHandsNetApiClient Api
@inject LocalizationService L

<PageTitle>@L["knowledge.title"] — OpenHandsNET</PageTitle>

<h2>@L["knowledge.title"]</h2>

<div class="knowledge">
    <div class="row">
        <select aria-label="@L["knowledge.title"]" @bind="_filter" @bind:after="LoadAsync">
            <option value="pending">@L["knowledge.pending"]</option>
            <option value="approved">@L["knowledge.approved"]</option>
            <option value="dismissed">@L["knowledge.dismissed"]</option>
            <option value="">@L["knowledge.all"]</option>
        </select>
        <button @onclick="GroomAsync" disabled="@_busy">
            @L["knowledge.groom"]
        </button>
    </div>

    @if (_items is null)
    {
        <p class="sub">@L["common.loading"]</p>
    }
    else if (_items.Count == 0)
    {
        <p class="sub">@L["knowledge.empty"]</p>
    }
    else
    {
        @foreach (var s in _items)
        {
            <div class="suggestion">
                <div class="head">
                    <span class="badge @s.Kind">@s.Kind</span>
                    <strong>@s.Title</strong>
                    <span class="meta">@s.Scope</span>
                    @if (s.Reason is not null)
                    {
                        <span class="meta">(@s.Reason)</span>
                    }
                </div>
                <div class="content">@s.Content</div>
                @if (s.Status == "pending")
                {
                    <div class="row">
                        <button class="primary"
                                @onclick="() => ApproveAsync(s.Id)">
                            @L["knowledge.approve"]
                        </button>
                        <button @onclick="() => DismissAsync(s.Id)">
                            @L["knowledge.dismiss"]
                        </button>
                    </div>
                }
                else
                {
                    <div class="meta">@s.Status — @s.Resolution</div>
                }
            </div>
        }
    }
</div>

@code {
    private IReadOnlyList<KnowledgeSuggestionItem>? _items;
    private string _filter = "pending";
    private bool _busy;

    protected override async Task OnInitializedAsync()
        => await LoadAsync();

    private async Task LoadAsync()
        => _items = await Api.ListKnowledgeSuggestionsAsync(
            string.IsNullOrEmpty(_filter) ? null : _filter);

    private async Task ApproveAsync(Guid id)
    {
        await Api.ApproveSuggestionAsync(id, null);
        await LoadAsync();
    }

    private async Task DismissAsync(Guid id)
    {
        await Api.DismissSuggestionAsync(id, null);
        await LoadAsync();
    }

    private async Task GroomAsync()
    {
        _busy = true;
        await Api.GroomKnowledgeAsync();
        await LoadAsync();
        _busy = false;
    }
}
