@page "/shared/{Id}"
@using OpenHandsNET.Client.Services
@using OpenHandsNET.Client.Components.Conversation
@using OpenHandsNET.Client.Components
@inject OpenHandsNetApiClient Api
@inject LocalizationService L

<PageTitle>@L["shared.title"] · OpenHandsNET</PageTitle>

<div class="conv-page">
    <div class="shared-banner">
        <Icon Name="external" Size="13" /> @L["shared.banner"]
    </div>
    <div class="chat-scroll" style="padding:16px">
        @if (_events is null)
        {
            <div class="ev-card condense">@L["common.loading"]</div>
        }
        else if (_events.Count == 0)
        {
            <div class="empty-state">@L["shared.empty"]</div>
        }
        else
        {
            @foreach (var e in _events)
            {
                <EventCard Event="e" />
            }
        }
    </div>
</div>

@code {
    [Parameter] public string Id { get; set; } = "";

    private IReadOnlyList<ClientEvent>? _events;

    protected override async Task OnInitializedAsync()
    {
        try { _events = await Api.GetEventsAsync(Id, limit: 100); }
        catch { _events = []; }
    }
}
