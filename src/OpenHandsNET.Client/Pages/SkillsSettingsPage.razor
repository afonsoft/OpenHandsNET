@page "/settings/skills"
@inject HttpClient Http
@inject OpenHandsNET.Client.Services.LocalizationService L

<PageTitle>@L["skills.title"] · OpenHandsNET</PageTitle>

<h1>@L["skills.title"]</h1>

<p>@L["skills.subtitle"]</p>

@if (skills == null)
{
    <p><em>@L["common.loading"]</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>@L["skills.name"]</th>
                <th>@L["skills.source"]</th>
                <th>@L["skills.description"]</th>
                <th>@L["skills.enabled"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in skills)
            {
                <tr>
                    <td><code>@s.Name</code></td>
                    <td>@s.Source</td>
                    <td>@s.Description</td>
                    <td>
                        <input type="checkbox" checked="@s.Enabled"
                               aria-label="@L["skills.enabled"]"
                               disabled="@(s.Source == "builtin")"
                               @onchange="_ => ToggleAsync(s)" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>@L["skills.new"]</h2>
<div>
    <input aria-label="@L["skills.name_placeholder"]" placeholder="@L["skills.name_placeholder"]" @bind="newName" />
    <input aria-label="@L["skills.desc_placeholder"]" placeholder="@L["skills.desc_placeholder"]" @bind="newDescription" />
    <textarea aria-label="@L["skills.content_placeholder"]" placeholder="@L["skills.content_placeholder"]" @bind="newContent" rows="6"
              style="width:100%"></textarea>
    <button @onclick="CreateAsync" disabled="@string.IsNullOrWhiteSpace(newName)">
        @L["common.create"]
    </button>
    @if (error is not null)
    {
        <p class="text-danger">@error</p>
    }
</div>

@code {
    private List<SkillDto>? skills;
    private string? newName;
    private string? newDescription;
    private string? newContent;
    private string? error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() =>
        skills = await Http.GetFromJsonAsync<List<SkillDto>>("api/v1/skills");

    private async Task CreateAsync()
    {
        error = null;
        var resp = await Http.PostAsJsonAsync("api/v1/skills", new
        {
            name = newName,
            description = newDescription,
            content_md = newContent ?? "",
            triggers = new[] { new { type = "always", value = (string?)null } },
        });
        if (!resp.IsSuccessStatusCode)
        {
            error = await resp.Content.ReadAsStringAsync();
            return;
        }

        newName = newDescription = newContent = null;
        await LoadAsync();
    }

    private async Task ToggleAsync(SkillDto skill)
    {
        await Http.PatchAsJsonAsync($"api/v1/skills/{skill.Id}",
            new { enabled = !skill.Enabled });
        await LoadAsync();
    }

    private sealed record SkillDto(
        Guid Id, string Name, string? Description,
        string Source, bool Enabled);
}
