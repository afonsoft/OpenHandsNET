@page "/"
@using OpenHandsNET.Client.Services
@inject OpenHandsNetApiClient Api
@inject LocalizationService L
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>OpenHandsNET</PageTitle>

<div class="home-wrap">
    <h1>OpenHandsNET</h1>
    <p class="sub">@L["home.subtitle"]</p>

    <div class="new-conv">
        <ChatComposer Placeholder="@L["composer.placeholder_new"]"
                      DraftKey="new" OnSend="OnComposerSendAsync" />
        <div class="row">
            <div class="mode-toggle" role="group">
                <button class="@(_mode == "agent" ? "on" : "")"
                        @onclick='() => _mode = "agent"'>@L["home.mode_agent"]</button>
                <button class="@(_mode == "ask" ? "on" : "")"
                        @onclick='() => _mode = "ask"'>@L["home.mode_ask"]</button>
            </div>
            <input placeholder="@L["home.repository_placeholder"]"
                   @bind="_repository" @bind:event="oninput" />
            <label title="@L["home.confirm_title"]">
                <input type="checkbox" @bind="_confirmMode" /> @L["home.confirmation"]
            </label>
            <button class="primary" @onclick="StartAsync" disabled="@_starting">
                @(_starting ? L["home.starting"] : L["home.run"])
            </button>
        </div>
        @if (_progress.Count > 0)
        {
            <div class="start-progress">
                @foreach (var (status, active) in _progress)
                {
                    <div class="step @(active ? "active" : "done")">
                        @(active ? "▸" : "✓") @status
                    </div>
                }
            </div>
        }
        @if (_error is not null)
        {
            <div class="start-progress"><div class="step" style="color:var(--ohn-red)">@_error</div></div>
        }
    </div>

    <div class="conv-list">
        @if (_conversations is null)
        {
            <p class="sub">@L["common.loading"]</p>
        }
        else if (_conversations.Count == 0)
        {
            <p class="sub">@L["home.empty"]</p>
        }
        else
        {
            @foreach (var c in _conversations)
            {
                <a class="conv-card" href="/conversations/@c.Id">
                    <span class="badge @BadgeClass(c.ExecutionStatus)">
                        <span class="dot"></span>@c.ExecutionStatus
                    </span>
                    <span class="title">@(c.Title ?? L["conversation.untitled"])</span>
                    <span class="meta">@(c.SelectedRepository ?? "")</span>
                    <span class="meta">@c.UpdatedAt.LocalDateTime.ToString("g")</span>
                </a>
            }
        }
    </div>
</div>

@code {
    private IReadOnlyList<ConversationItem>? _conversations;
    private string _initialMessage = "";
    private string _repository = "";
    private string _mode = "agent";
    private bool _confirmMode;
    private bool _starting;
    private string? _error;
    private readonly List<(string Status, bool Active)> _progress = [];
    private readonly string[] _pipeline =
        ["WORKING", "SETTING_UP_WORKSPACE", "SETTING_UP_GIT", "SETTING_UP_SKILLS", "READY"];
    private System.Timers.Timer? _poll;

    protected override async Task OnInitializedAsync()
    {
        try { _conversations = await Api.ListConversationsAsync(); }
        catch { _conversations = []; }
    }

    private static string BadgeClass(string status) =>
        "badge " + status.ToLowerInvariant().Replace(' ', '_');

    /// <summary>SPEC-45: composer da Home — envio inicia a conversa.</summary>
    private async Task OnComposerSendAsync(string text)
    {
        _initialMessage = text;
        // SPEC-60 RF-003: modo Ask — sessão read-only com citações.
        if (_mode == "ask")
        {
            var s = await Api.CreateAskSessionAsync(_repository, text);
            if (s is not null) { Nav.NavigateTo($"/ask/{s.Id}"); }
            return;
        }
        await StartAsync();
    }

    private async Task StartAsync()
    {
        _starting = true;
        _error = null;
        _progress.Clear();
        try
        {
            var task = await Api.CreateConversationAsync(
                string.IsNullOrWhiteSpace(_initialMessage) ? null : _initialMessage,
                string.IsNullOrWhiteSpace(_repository) ? null : _repository,
                run: true, confirmationMode: _confirmMode);
            TrackStatus(task.Status);
            _poll = new System.Timers.Timer(1200);
            _poll.Elapsed += async (_, _) => await PollTaskAsync(task.Id);
            _poll.AutoReset = true;
            _poll.Start();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _starting = false;
        }
    }

    private async Task PollTaskAsync(string taskId)
    {
        try
        {
            var t = await Api.GetStartTaskAsync(taskId);
            if (t is null) { return; }
            await InvokeAsync(() => { TrackStatus(t.Status); StateHasChanged(); });
            if (t.Status is "READY")
            {
                _poll?.Stop();
                Nav.NavigateTo($"/conversations/{t.AppConversationId}");
            }
            else if (t.Status is "ERROR")
            {
                _poll?.Stop();
                await InvokeAsync(() =>
                {
                    _error = t.Detail ?? L["home.start_failed"];
                    _starting = false;
                    StateHasChanged();
                });
            }
        }
        catch { /* retry no próximo tick */ }
    }

    private void TrackStatus(string status)
    {
        var idx = Array.IndexOf(_pipeline, status);
        for (var i = 0; i < _progress.Count; i++)
        {
            _progress[i] = (_progress[i].Status, false);
        }

        for (var i = 0; i <= idx && i < _pipeline.Length; i++)
        {
            if (_progress.All(p => p.Status != _pipeline[i]))
            {
                _progress.Add((_pipeline[i], i == idx && status != "READY"));
            }
        }
    }

    public void Dispose() => _poll?.Dispose();
}
