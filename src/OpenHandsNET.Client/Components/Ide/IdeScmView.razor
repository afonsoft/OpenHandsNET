@using OpenHandsNET.Client.Services
@using OpenHandsNET.Client.Components.Conversation
@inject OpenHandsNetApiClient Api
@inject LocalizationService L

@* SPEC-42 RF-005: SCM view — changes + diff (via callback p/ o editor) +
   commit box → POST /git/commit. *@

<div class="ide-scm">
    <div class="ide-panel-head">
        <span>@L["ide.scm_title"]</span>
        <button title="@L["common.refresh"]" aria-label="@L["ide.scm_refresh"]"
                @onclick="LoadAsync">
            <Icon Name="refresh" Size="13" />
        </button>
    </div>

    <div class="ide-commitbox">
        <input placeholder="@L["ide.commit_placeholder"]" @bind="_msg"
               @bind:event="oninput" @onkeydown="OnKey"
               aria-label="@L["ide.commit_aria"]" />
        <button class="primary" disabled="@(_busy || _msg.Trim().Length == 0)"
                @onclick="CommitAsync" aria-label="@L["ide.commit"]">
            <Icon Name="check" Size="13" /> @L["ide.commit"]
        </button>
    </div>
    @if (_feedback is { } fb)
    {
        <div class="ide-scm-fb">@fb</div>
    }

    @if (_files.Count == 0)
    {
        <div class="empty-state">@L["ide.no_changes"]</div>
    }
    else
    {
        @foreach (var f in _files)
        {
            <button class="ide-scm-row" @onclick="() => OpenDiff(f)">
                <Icon Name="file" Size="12" /> @f
            </button>
        }
    }

    @* SPEC-43 RF-004: checkpoints embutidos no painel SCM (soft-dep —
       componente também standalone na aba commits). *@
    <CheckpointList ConversationId="@ConversationId"
                    OnChanged="@(async () => await LoadAsync())" />
</div>

@code {
    [Parameter, EditorRequired] public string ConversationId { get; set; } = "";
    [Parameter] public ConversationStateService? State { get; set; }
    /// <summary>Abre o diff no editor do workbench.</summary>
    [Parameter] public EventCallback<string> OnOpenDiff { get; set; }

    private readonly List<string> _files = [];
    private string _msg = "";
    private string? _feedback;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var changes = await Api.GetGitChangesAsync(ConversationId);
            _files.Clear();
            if (changes.TryGetProperty("files", out var f))
            {
                foreach (var item in f.EnumerateArray())
                {
                    string p;
                    if (item.ValueKind
                        == System.Text.Json.JsonValueKind.String)
                    {
                        p = item.GetString()!;
                    }
                    else if (item.TryGetProperty("path", out var pp))
                    {
                        p = pp.GetString()!;
                    }
                    else
                    {
                        p = item.ToString();
                    }

                    _files.Add(p);
                }
            }
        }
        catch { /* best-effort — falha tolerada */ }
    }

    private async Task OpenDiff(string rel) =>
        await OnOpenDiff.InvokeAsync(rel);

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CommitAsync();
        }
    }

    private async Task CommitAsync()
    {
        if (_msg.Trim().Length == 0 || _busy) { return; }
        _busy = true;
        try
        {
            var sha = await Api.GitCommitAsync(
                ConversationId, _msg.Trim());
            _feedback = sha is null
                ? "commit falhou" : $"committed {sha[..Math.Min(7, sha.Length)]}";
            if (sha is not null)
            {
                _msg = "";
                await LoadAsync();
            }
        }
        finally { _busy = false; }
    }
}
