@using OpenHandsNET.Client.Services
@inject LocalizationService L
@implements IAsyncDisposable
@inject OpenHandsNetApiClient Api
@inject MonacoInterop Monaco
@inject ToastService Toasts

<div style="display:flex;flex-direction:column;height:100%">
    <div class="diff-meta">
        @_files.Count arquivo(s) alterado(s) · <span style="color:var(--ohn-green)">+@_adds</span> ·
        <span style="color:var(--ohn-red)">−@_dels</span>
        <button style="float:right" @onclick="LoadAsync">↻</button>
    </div>
    @* SPEC-21 RF-004: chips de arquivos + diff editor HEAD × workspace. *@
    @if (_files.Count > 0)
    {
        <div class="diff-tab-list">
            @foreach (var f in _files)
            {
                <button class="@(f == _selected ? "sel" : "")"
                        @onclick="() => SelectAsync(f)">@f</button>
            }
        </div>
    }
    @* SPEC-135 RF-006: strip de hunks do arquivo selecionado — revert
       por hunk (reverse-apply no servidor) + slot "comentar → agente"
       desabilitado (fora de escopo da beta). *@
    @if (_selected is not null)
    {
        <div class="hunk-strip">
            @for (var i = 0; i < HunkCount(); i++)
            {
                var idx = i;
                <button class="hunk-btn" disabled="@_reverting"
                        title="@L["diff.revert_hunk"]"
                        @onclick="() => RevertHunkAsync(idx)">
                    <Icon Name="undo" Size="11" /> @L["diff.hunk"] @(idx + 1)
                </button>
            }
            <button class="hunk-btn" disabled
                    title="@L["diff.comment_soon"]">
                <Icon Name="chat" Size="11" /> @L["diff.comment_agent"]
            </button>
        </div>
    }
    <div style="flex:1;min-height:0;overflow:auto">
        @if (_loading)
        {
            <div class="empty-state">@L["common.loading"]</div>
        }
        else if (_files.Count == 0)
        {
            <div class="empty-state">@L["diff.empty"]</div>
        }
        else if (_monacoFailed)
        {
            @* SPEC-120: fallback mostra só a seção do arquivo selecionado
               (GitDiffRender.SplitDiff). *@
            <pre style="margin:0;padding:8px 0">
                @foreach (var line in SelectedDiff().Split('\n'))
                {
                    <span class="diff-line @GitDiffRender.LineClass(line)">@line</span>
                }
            </pre>
        }
        else
        {
            <div id="diff-monaco" class="monaco-host"></div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ConversationStateService State { get; set; } = default!;

    private string? _diff;
    private Dictionary<string, string> _sections = [];
    private readonly List<string> _files = [];
    private string? _selected;
    private int _adds, _dels;
    private bool _monacoFailed;
    private bool _monacoDirty;
    private bool _loading = true;
    private bool _reverting;
    private string _orig = "";
    private string _mod = "";

    private const string RepoRoot = "/workspace/repo";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_monacoDirty && !_monacoFailed && _selected is not null)
        {
            _monacoDirty = false;
            try
            {
                await Monaco.CreateDiffEditorAsync("diff-monaco",
                    _orig, _mod, MonacoInterop.LanguageFor(_selected));
            }
            catch (JSException)
            {
                _monacoFailed = true;
                await InvokeAsync(StateHasChanged);
            }
            catch (InvalidOperationException)
            {
                _monacoFailed = true;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var changes = await Api.GetGitChangesAsync(State.Conversation!.Id);
            _files.Clear();
            if (changes.TryGetProperty("files", out var f)
                || changes.TryGetProperty("items", out f))
            {
                foreach (var item in f.EnumerateArray())
                {
                    var p = item.ValueKind == System.Text.Json.JsonValueKind.String
                        ? item.GetString()!
                        : PathOf(item);
                    _files.Add(p);
                }
            }

            _diff = await Api.GetGitDiffAsync(State.Conversation.Id);
            _sections = GitDiffRender.SplitDiff(_diff);
            (_adds, _dels) = GitDiffRender.Stats(_diff);

            _selected = _files.FirstOrDefault();
            _loading = false;
            if (_selected is not null)
            {
                await LoadPairAsync(_selected);
            }
        }
        catch
        {
            _diff ??= "";
            _loading = false;
        }
    }

    private async Task SelectAsync(string file)
    {
        _selected = file;
        await LoadPairAsync(file);
    }

    private async Task LoadPairAsync(string rel)
    {
        _orig = await Api.GetGitFileAtRefAsync(
            State.Conversation!.Id, rel, "HEAD") ?? "";
        _mod = await Api.ReadFileAsync(
            State.Conversation.Id, $"{RepoRoot}/{rel}");
        _monacoDirty = true;
    }

    /// <summary>SPEC-120: seção do diff do arquivo selecionado.</summary>
    private string SelectedDiff() =>
        _selected is not null && _sections.TryGetValue(_selected, out var sec)
            ? sec
            : _diff ?? "";

    /// <summary>SPEC-135 RF-006: qtd. de hunks (<c>@@</c>) na seção ativa.</summary>
    private int HunkCount()
    {
        var sec = SelectedDiff();
        return sec.Split('\n')
            .Count(l => l.StartsWith("@@ ", StringComparison.Ordinal));
    }

    /// <summary>
    /// SPEC-135 RF-006: reverse-apply de um hunk — o servidor devolve
    /// applied/conflicts por índice; sucesso recarrega o diff.
    /// </summary>
    private async Task RevertHunkAsync(int idx)
    {
        if (_selected is null || State.Conversation is null)
        {
            return;
        }

        _reverting = true;
        try
        {
            var r = await Api.RevertHunksAsync(
                State.Conversation.Id, _selected, [idx]);
            if (r.Applied.Count > 0)
            {
                Toasts.Success(L.T("diff.hunk_reverted",
                    ("n", (idx + 1).ToString())));
                await LoadAsync();
            }
            else
            {
                Toasts.Error(L.T("diff.hunk_conflict",
                    ("n", (idx + 1).ToString())));
            }
        }
        catch (HttpRequestException ex)
        {
            Toasts.Error(L.T("diff.hunk_failed", ("error", ex.Message)));
        }
        finally
        {
            _reverting = false;
        }
    }

    private static string LineClass(string line) =>
        line switch
        {
            _ when line.StartsWith("+++") || line.StartsWith("---")
                => "hunk",
            _ when line.StartsWith('+') => "add",
            _ when line.StartsWith('-') => "del",
            _ when line.StartsWith("@@") => "hunk",
            _ => "",
        };

    private static string PathOf(System.Text.Json.JsonElement item)
    {
        if (item.TryGetProperty("path", out var pp))
        {
            return pp.GetString()!;
        }

        return item.ToString();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Monaco.DisposeAsync("diff-monaco");
        }
        catch (JSException) { /* best-effort — falha tolerada */ }
        catch (JSDisconnectedException) { /* best-effort — falha tolerada */ }
    }
}
