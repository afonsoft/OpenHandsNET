@using OpenHandsNET.Client.Services
@using OpenHandsNET.Client.Components
@inject IJSRuntime JS

<div class="chat-scroll" id="chat-scroll" @ref="_scroll">
    @if (State.LoadingBacklog)
    {
        <div class="ev-card condense">loading history…</div>
    }
    @foreach (var e in State.Events)
    {
        // SPEC-45 RF-006: última mensagem do usuário ganha "Editar".
        var isLastUser = ReferenceEquals(e, _lastUser);
        <div class="ev-wrap @(isLastUser ? "editable" : "")">
            <EventCard Event="e" Siblings="State.Events" />
            @if (isLastUser && _composer is not null)
            {
                <button class="ev-edit" title="Editar e reenviar"
                        @onclick="EditLastUserAsync">editar</button>
            }
        </div>
    }
    @* SPEC-34: slots de delta efêmeros — removidos quando o evento durável
       com o mesmo item_id chega (supersedes). Cursor ▍ via CSS .delta::after.
       SPEC-41 RF-002: reasoning renderiza na ThinkingSection, auto-colapsa
       quando o content do mesmo item_id começa. *@
    @foreach (var r in State.LiveReasoning)
    {
        <ThinkingSection Reasoning="@r.Value" Streaming="true"
                         ContentStarted="@State.LiveDeltas.ContainsKey(r.Key)" />
    }
    @foreach (var delta in State.LiveDeltas)
    {
        <div class="ev-card msg delta" data-item-id="@delta.Key">
            <div class="ev-head"><span>assistant</span><em>streaming…</em></div>
            <pre>@delta.Value</pre>
        </div>
    }
    @if (State.Stalled)
    {
        <div class="ev-card condense" role="status">
            <div class="ev-head" style="justify-content:center">
                <Icon Name="alert" Size="13" />
                <span>sem sinal do agente há 45s+ — aguardando heartbeat…</span>
            </div>
        </div>
    }
</div>
@if (State.ErrorMessage is { } err)
{
    <div class="ev-card error" style="margin:0 16px 8px">
        <div class="ev-head"><Icon Name="alert" Size="14" /><span>error</span></div>
        <pre>@err</pre>
    </div>
}
@if (State.PendingAction is { } pending)
{
    <ConfirmationBanner Pending="pending" OnConfirm="OnConfirm" />
}
<ChatComposer @ref="_composer"
              ConversationId="@State.Conversation?.Id"
              DraftKey="@(State.Conversation?.Id ?? "new")"
              Busy="@(State.ExecutionStatus is "RUNNING")"
              Paused="@(State.ExecutionStatus is "PAUSED")"
              OnSend="SendTextAsync"
              OnPause="() => State.PauseAsync()"
              OnInterrupt="() => State.InterruptAsync()"
              OnResume="() => State.ResumeAsync()" />

@code {
    [Parameter, EditorRequired] public ConversationStateService State { get; set; } = default!;

    private ElementReference _scroll;
    private ChatComposer? _composer;
    private int _lastCount;

    /// <summary>Último MessageEvent user — alvo do edit-resend.</summary>
    private OpenHandsNET.Client.Services.ClientEvent? _lastUser =>
        State.Events.LastOrDefault(e =>
            e.Kind == "MessageEvent" && e.Str("source") == "user");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // SPEC-26 RF-003: auto-scroll só quando o usuário está no fim.
            // JS é best-effort — bUnit strict lança exceção própria.
            try { await JS.InvokeVoidAsync("ohnChat.pin", _scroll); }
            catch (Exception) { }
        }

        if (State.Events.Count != _lastCount || State.LiveDeltas.Count > 0)
        {
            _lastCount = State.Events.Count;
            try { await JS.InvokeVoidAsync("ohnChat.scrollIfPinned", _scroll); }
            catch (Exception) { }
        }
    }

    private async Task SendTextAsync(string text) =>
        await State.SendMessageAsync(text);

    /// <summary>RF-006: carrega a última msg do usuário no composer.</summary>
    private async Task EditLastUserAsync()
    {
        if (_lastUser is { } e && _composer is not null)
        {
            await _composer.SetTextAsync(e.MessageText());
        }
    }

    private async Task OnConfirm(bool approved) => await State.ConfirmAsync(approved);
}
