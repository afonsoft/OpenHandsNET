@* SPEC-45: composer compartilhado (Home + ChatPane) — textarea
   auto-grow, @menções p/ paths do workspace, /slash (builtins+skills),
   drafts+histórico em localStorage, anexos→path reference.
   Enter envia / Shift+Enter quebra; popups ↑↓+Enter/Esc/Tab. *@
@using OpenHandsNET.Client.Services
@inject OpenHandsNetApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ToastService Toasts
@inject LocalizationService L

<div class="composer">
    @if (_attachments.Count > 0 || MentionTokens().Any())
    {
        <div class="composer-chips">
            @foreach (var m in MentionTokens())
            {
                <span class="chip mention" title="@m">@("@" + Short(m))</span>
            }
            @foreach (var a in _attachments)
            {
                <span class="chip attach" title="@a.Path">
                    <Icon Name="file" Size="12" /> @a.Name
                    <button class="chip-x" aria-label="@L["composer.remove_attachment"]"
                            @onclick="() => _attachments.Remove(a)">×</button>
                </span>
            }
        </div>
    }
    <div class="composer-row">
        @if (ConversationId is not null)
        {
            <label class="icon-btn attach-btn" title="@L["composer.attach"]">
                <Icon Name="plus" Size="16" />
                <InputFile OnChange="OnFileAsync" style="display:none"
                           aria-label="@L["composer.attach"]" />
            </label>
        }
        <div class="composer-field">
            @if (_mentionOpen && _mentionItems.Count > 0)
            {
                <div class="popup" role="listbox" aria-label="@L["composer.files"]">
                    @for (var i = 0; i < _mentionItems.Count; i++)
                    {
                        var p = _mentionItems[i];
                        <button class="popup-item @(i == _idx ? "sel" : "")"
                                @onclick="() => PickMention(p)">
                            <Icon Name="file" Size="13" /> @p
                        </button>
                    }
                </div>
            }
            @if (_slashOpen && _slashItems.Count > 0)
            {
                <div class="popup" role="listbox" aria-label="@L["composer.commands"]">
                    @for (var i = 0; i < _slashItems.Count; i++)
                    {
                        var c = _slashItems[i];
                        <button class="popup-item @(i == _idx ? "sel" : "")"
                                @onclick="() => PickSlash(c)">
                            <span class="slash-name">/@c.Name</span>
                            <span class="slash-desc">@c.Description</span>
                        </button>
                    }
                </div>
            }
            <textarea @ref="_ta" rows="1" placeholder="@(Placeholder ?? L["composer.placeholder"])"
                      @bind="_text" @bind:event="oninput"
                      @bind:after="OnTextChanged"
                      @onkeydown="OnKey" disabled="@Sending"
                      aria-label="@L["composer.message"]" class="composer-ta"></textarea>
        </div>
        <button class="primary send-btn" @onclick="SendAsync"
                disabled="@(Sending || string.IsNullOrWhiteSpace(_text))"
                aria-label="@L["composer.send"]">
            <Icon Name="send" Size="14" />
        </button>
        @if (Busy)
        {
            <button title="@L["composer.pause"]" aria-label="@L["composer.pause"]"
                    @onclick="OnPause"><Icon Name="pause" Size="14" /></button>
            <button title="@L["composer.interrupt"]" aria-label="@L["composer.interrupt"]"
                    @onclick="OnInterrupt"><Icon Name="stop" Size="14" /></button>
        }
        @if (Paused)
        {
            <button title="@L["composer.resume"]" aria-label="@L["composer.resume"]"
                    @onclick="OnResume"><Icon Name="play" Size="14" /></button>
        }
    </div>
    <div class="composer-foot">
        <span class="char-count">@_text.Length</span>
        @if (Sending) { <span class="sending">@L["composer.sending"]</span> }
    </div>
</div>

@code {
    /// <summary>Conversa alvo — null na Home (mention/attach off).</summary>
    [Parameter] public string? ConversationId { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    /// <summary>Run ativo → mostra pause/interrupt.</summary>
    [Parameter] public bool Busy { get; set; }
    /// <summary>Run pausado → mostra resume.</summary>
    [Parameter] public bool Paused { get; set; }
    /// <summary>Envio — recebe o texto final (mentions+anexos inline).</summary>
    [Parameter, EditorRequired] public EventCallback<string> OnSend { get; set; }
    [Parameter] public EventCallback OnPause { get; set; }
    [Parameter] public EventCallback OnInterrupt { get; set; }
    [Parameter] public EventCallback OnResume { get; set; }
    /// <summary>Sufixo das chaves localStorage (convId ou "new").</summary>
    [Parameter] public string DraftKey { get; set; } = "new";

    private ElementReference _ta;
    private string _text = "";
    private bool _mentionOpen, _slashOpen;
    private string _mentionQuery = "", _slashQuery = "";
    private int _idx;
    private List<string> _mentionItems = [];
    private List<ComposerSlash.Command> _slashItems = [];
    private List<string>? _treeCache;
    private List<ComposerSlash.Command>? _slashCache;
    private List<string> _history = [];
    private int _histIdx = -1;
    private string _histSaved = "";
    private readonly List<Attachment> _attachments = [];
    private bool _firstRender = true;

    /// <summary>Envio em andamento (pai desabilita via Busy? — flag interna).</summary>
    public bool Sending { get; private set; }

    private sealed record Attachment(string Name, string Path);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_firstRender) { return; }
        _firstRender = false;
        try
        {
            _text = await JS.InvokeAsync<string?>("localStorage.getItem",
                $"ohn.draft.{DraftKey}") ?? "";
            _history = (await JS.InvokeAsync<string?>("localStorage.getItem",
                $"ohn.history.{DraftKey}")) is { } h
                ? h.Split('\n', StringSplitOptions.RemoveEmptyEntries).ToList()
                : [];
            await JS.InvokeVoidAsync("ohnComposer.grow", _ta);
            StateHasChanged();
        }
        catch (Exception) { /* JS indisponível (bUnit strict) */ }
    }

    /// <summary>RF-006: carrega texto externo (edit-resend) e foca.</summary>
    public async Task SetTextAsync(string text)
    {
        _text = text;
        ClosePopups();
        StateHasChanged();
        try { await JS.InvokeVoidAsync("ohnComposer.focus", _ta); }
        catch (Exception) { /* best-effort — falha tolerada */ }
    }

    private async Task OnTextChanged()
    {
        // Draft persist.
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem",
                $"ohn.draft.{DraftKey}", _text);
            await JS.InvokeVoidAsync("ohnComposer.grow", _ta);
        }
        catch (Exception) { /* best-effort — falha tolerada */ }

        UpdatePopups();
    }

    private void UpdatePopups()
    {
        // Mention: último token começa com @ (após espaço/início).
        var span = _text.AsSpan();
        var at = span.LastIndexOf('@');
        if (at >= 0 && (at == 0 || char.IsWhiteSpace(span[at - 1]))
            && !span[(at + 1)..].Contains(' '))
        {
            _mentionQuery = span[(at + 1)..].ToString();
            _ = OpenMention();
        }
        else { _mentionOpen = false; }

        // Slash: texto começa com '/' e o 1º token ainda está sendo
        // digitado (sem espaço) — depois do espaço vira args.
        if (_text.StartsWith('/') && !_text.Contains(' ')
            && !_text.Contains('\n'))
        {
            _slashQuery = _text[1..];
            _ = OpenSlash();
        }
        else { _slashOpen = false; }

        _idx = 0;
    }

    private async Task OpenMention()
    {
        if (ConversationId is null) { return; }
        _mentionOpen = true;
        _treeCache ??= await LoadTreeAsync();
        _mentionItems = _treeCache
            .Select(p => (p, IdeQuickOpenFuzzy.Score(_mentionQuery, p)))
            .Where(t => t.Item2 > 0)
            .OrderByDescending(t => t.Item2)
            .Select(t => t.p).Take(8).ToList();
        StateHasChanged();
    }

    private async Task OpenSlash()
    {
        _slashOpen = true;
        _slashCache ??= await LoadSlashAsync();
        _slashItems = ComposerSlash.Filter(_slashCache, _slashQuery)
            .Take(8).ToList();
        StateHasChanged();
    }

    private async Task<List<string>> LoadTreeAsync()
    {
        try
        {
            // find 1-chamada — cobre repo + uploads (cap 500).
            var r = await Api.ExecOneShotAsync(ConversationId!,
                "find /workspace -type f -not -path '*/.git/*' " +
                "-not -path '*/.ohn-checkpoints/*' | head -500", 15);
            return r.Stdout.Split('\n',
                StringSplitOptions.RemoveEmptyEntries).ToList();
        }
        catch (Exception) { return []; }
    }

    private async Task<List<ComposerSlash.Command>> LoadSlashAsync()
    {
        var cmds = ComposerSlash.Builtins.ToList();
        if (ConversationId is not null)
        {
            try
            {
                cmds.AddRange(ComposerSlash.FromSkills(
                    await Api.GetConversationSkillsAsync(ConversationId)));
            }
            catch (Exception) { /* best-effort — falha tolerada */ }
        }

        return cmds;
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if ((_mentionOpen && _mentionItems.Count > 0)
            || (_slashOpen && _slashItems.Count > 0))
        {
            var items = _mentionOpen
                ? _mentionItems.Count : _slashItems.Count;
            _idx = Math.Min(_idx, items - 1);
            switch (e.Key)
            {
                case "ArrowDown":
                    _idx = (_idx + 1) % items; return;
                case "ArrowUp":
                    _idx = (_idx - 1 + items) % items; return;
                case "Tab":
                case "Enter" when !e.ShiftKey:
                    if (_mentionOpen)
                    {
                        PickMention(_mentionItems[_idx]);
                    }
                    else { await PickSlash(_slashItems[_idx]); }
                    return;
                case "Escape":
                    ClosePopups(); return;
            }
        }

        if (e.Key is "Enter" && !e.ShiftKey)
        {
            await SendAsync();
        }
        else if (e.Key is "ArrowUp" && !_mentionOpen && !_slashOpen
                 && _history.Count > 0 && await CaretAtStartAsync())
        {
            HistoryMove(+1);
        }
        else if (e.Key is "ArrowDown" && _histIdx >= 0)
        {
            HistoryMove(-1);
        }
    }

    private void HistoryMove(int delta)
    {
        if (_histIdx < 0)
        {
            _histSaved = _text;
            _histIdx = -1;
        }

        var next = Math.Clamp(_histIdx + delta, -1,
            _history.Count - 1);
        if (next == _histIdx) { return; }
        _histIdx = next;
        _text = _histIdx < 0 ? _histSaved : _history[_histIdx];
    }

    private void PickMention(string path)
    {
        // Substitui o token @query do fim pelo path completo.
        var at = _text.LastIndexOf('@');
        _text = _text[..at] + "@" + path + " ";
        _mentionOpen = false;
    }

    private async Task PickSlash(ComposerSlash.Command cmd)
    {
        _slashOpen = false;
        var args = _text.Contains(' ')
            ? _text[(_text.IndexOf(' ') + 1)..] : "";
        _text = "";
        switch (cmd.Kind)
        {
            case ComposerSlash.CommandKind.Mode:
                if (ConversationId is not null)
                {
                    await Api.SetModeAsync(ConversationId, cmd.Name);
                    Toasts.Success(L.T("composer.toast_mode", ("mode", cmd.Name)));
                }
                break;
            case ComposerSlash.CommandKind.Compact:
                if (ConversationId is not null)
                {
                    await Api.CompactContextAsync(ConversationId);
                    Toasts.Success(L["composer.toast_compacted"]);
                }
                break;
            case ComposerSlash.CommandKind.New:
                Nav.NavigateTo("/");
                break;
            default: // Skill — expande no composer p/ revisão antes do envio.
                await SetTextAsync(ComposerSlash.Expand(cmd, args));
                break;
        }
    }

    private void ClosePopups() => _mentionOpen = _slashOpen = false;

    private async Task<bool> CaretAtStartAsync()
    {
        try
        {
            return await JS.InvokeAsync<bool>(
                "ohnComposer.caretAtStart", _ta);
        }
        catch (Exception) { return _text.Length == 0; }
    }

    private async Task OnFileAsync(InputFileChangeEventArgs e)
    {
        if (ConversationId is null) { return; }
        var f = e.File;
        const long MaxUploadBytes = 10 * 1024 * 1024;
        if (f.Size > MaxUploadBytes)
        {
            Toasts.Warn(L["composer.toast_too_big"]);
            return;
        }

        try
        {
            var bytes = new byte[(int)f.Size];
            await using var s = f.OpenReadStream(MaxUploadBytes);
            var read = 0;
            while (read < bytes.Length)
            {
                var n = await s.ReadAsync(bytes.AsMemory(read));
                if (n == 0) { break; }
                read += n;
            }

            var path = await Api.UploadFileAsync(
                ConversationId, f.Name, bytes, f.ContentType);
            if (path is null)
            {
                Toasts.Error(L["composer.toast_upload_rejected"]);
                return;
            }

            _attachments.Add(new Attachment(f.Name, path));
        }
        catch (Exception ex)
        {
            Toasts.Error(L.T("composer.toast_upload_failed", ("error", ex.Message)));
        }
    }

    private async Task SendAsync()
    {
        if (Sending || string.IsNullOrWhiteSpace(_text)) { return; }
        var text = _text.TrimEnd();
        // /skill args digitado + Enter (popup já fechou pelo espaço):
        // expande o template antes de enviar quando o nome resolve.
        if (text.StartsWith('/') && _slashCache is { } cmds
            && text[1..].Split(' ', 2) is { } parts
            && cmds.FirstOrDefault(c =>
                c.Name.Equals(parts[0],
                    StringComparison.OrdinalIgnoreCase)) is { } hit
            && hit.Kind == ComposerSlash.CommandKind.Skill)
        {
            text = ComposerSlash.Expand(hit,
                parts.Length > 1 ? parts[1] : "");
        }

        var sb = new System.Text.StringBuilder(text);
        foreach (var a in _attachments)
        {
            sb.Append("\n\n").Append(
                L.T("composer.attachment_tag", ("path", a.Path)));
        }

        text = sb.ToString();

        Sending = true;
        try
        {
            await OnSend.InvokeAsync(text);
            // Histórico + draft reset.
            _history.Insert(0, text.Replace('\n', '⏎'));
            if (_history.Count > 50) { _history.RemoveAt(50); }
            try
            {
                await JS.InvokeVoidAsync("localStorage.setItem",
                    $"ohn.history.{DraftKey}", string.Join('\n', _history));
                await JS.InvokeVoidAsync("localStorage.removeItem",
                    $"ohn.draft.{DraftKey}");
                await JS.InvokeVoidAsync("ohnComposer.grow", _ta);
            }
            catch (Exception) { /* cleanup JS best-effort */ }

            _text = "";
            _histIdx = -1;
            _attachments.Clear();
            ClosePopups();
        }
        finally { Sending = false; }
    }

    private IEnumerable<string> MentionTokens()
    {
        foreach (var tok in _text.Split(' ',
            StringSplitOptions.RemoveEmptyEntries))
        {
            if (tok.StartsWith('@') && tok.Length > 1)
            {
                yield return tok[1..];
            }
        }
    }

    private static string Short(string path) =>
        path.Length <= 40 ? path : "…" + path[^38..];
}
