@* SPEC-26 RF-004: banner de conexão — aparece quando o hub está
   Reconnecting/Disconnected/Closed; some em Connected. *@
@using OpenHandsNET.Client.Services
@using Microsoft.AspNetCore.SignalR.Client
@inject ConversationHubClient Hub
@inject LocalizationService L
@implements IDisposable

@if (_state is HubConnectionState.Reconnecting)
{
    <div class="offline-banner" role="alert">
        <Icon Name="spin" Size="14" />
        <span class="spin-label">@L["offline.reconnecting"]</span>
    </div>
}
else if (_state is HubConnectionState.Disconnected && _everConnected)
{
    <div class="offline-banner" role="alert">
        <Icon Name="alert" Size="14" />
        <span>@L["offline.lost"]</span>
    </div>
}

@code {
    private HubConnectionState _state = HubConnectionState.Disconnected;
    private bool _everConnected;

    protected override void OnInitialized()
    {
        _state = Hub.State;
        _everConnected = _state == HubConnectionState.Connected;
        Hub.ConnectionChanged += OnState;
    }

    private void OnState(HubConnectionState s)
    {
        _state = s;
        if (s == HubConnectionState.Connected)
        {
            _everConnected = true;
        }
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Hub.ConnectionChanged -= OnState;
}
