@* SPEC-26 RF-004: host de toasts — canto inferior direito, dismiss manual. *@
@using OpenHandsNET.Client.Services
@inject ToastService Toasts
@implements IDisposable

<div class="toast-host" role="status" aria-live="polite">
    @foreach (var t in Toasts.Toasts)
    {
        var cls = t.Severity.ToString().ToLowerInvariant();
        <div class="toast @cls" role="alert">
            <Icon Name="@IconFor(t.Severity)" Size="15" />
            <span class="msg">@t.Message</span>
            <button class="x" aria-label="Dismiss"
                    @onclick="() => Toasts.Dismiss(t.Id)">
                <Icon Name="x" Size="14" />
            </button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() =>
        Toasts.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private static string IconFor(ToastService.Level l) => l switch
    {
        ToastService.Level.Success => "check",
        ToastService.Level.Warn => "alert",
        ToastService.Level.Error => "alert",
        _ => "info",
    };

    public void Dispose() => Toasts.Changed -= OnChanged;
}
