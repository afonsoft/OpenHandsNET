@implements IDisposable
@using OpenHandsNET.Client.Services
@inject DialogService Dialogs
@inject LocalizationService L
@inject IJSRuntime JS

@* SPEC-119 (port OWUIC DialogHost): host dos diálogos modais in-app
   (confirm/prompt) — substitui window.confirm/window.prompt nativos por
   um dialog acessível: role=dialog, focus trap, Escape cancela,
   backdrop clica fora cancela. *@

@if (Dialogs.Current is { Kind: DialogKind.Lightbox } lb)
{
    @* RF-006: lightbox — imagem em overlay, ESC/backdrop fecham. *@
    <div class="modal-backdrop lightbox" @onclick="Cancel">
        <img src="@lb.Message" alt="@lb.DefaultValue" class="lightbox-img"
             @onclick:stopPropagation />
    </div>
}
else if (Dialogs.Current is { } req)
{
    <div class="modal-backdrop" @onclick="Cancel">
        <div class="modal @(req.Kind == DialogKind.Settings ? "settings-modal" : "max-w-md")"
             role="dialog" aria-modal="true"
             aria-label="@(req.Kind == DialogKind.Settings
                 ? L["settings.title"] : L["common.confirm"])" tabindex="-1"
             @ref="_dialog" @onkeydown="OnKeyDown" @onclick:stopPropagation>
            <div class="modal-body">
                @if (req.Kind == DialogKind.Settings)
                {
                    @* SPEC-130 RF-001: SettingsModal — mesmo conteúdo da
                       rota /settings; ESC/backdrop/botão fecham. *@
                    <div class="settings-modal-head">
                        <h2>@L["settings.title"]</h2>
                        <button type="button" class="icon-btn"
                                aria-label="@L["common.close"]"
                                @onclick="Cancel">
                            <Icon Name="x" Size="16" />
                        </button>
                    </div>
                    <OpenHandsNET.Client.Components.Settings.SettingsContent />
                }
                else if (req.Kind == DialogKind.Link)
                {
                    @* RF-005: ShareDialog — link readonly + copiar. *@
                    <input class="input w-full" readonly value="@req.DefaultValue"
                           aria-label="@L["conv.share"]" @ref="_linkInput" />
                    <div class="mt-5 flex justify-end gap-2">
                        <button type="button"
                                class="rounded-full px-4 py-1.5 text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition cursor-pointer"
                                @onclick="Cancel">
                            @L["common.close"]
                        </button>
                        <button type="button"
                                class="rounded-full px-4 py-1.5 text-sm font-medium bg-gray-900 text-white hover:bg-gray-800 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200 transition cursor-pointer"
                                @onclick="CopyLinkAsync">
                            @(_copied ? L["conv.share_copied"] : L["common.copy"])
                        </button>
                    </div>
                }
                else
                {
                <p class="text-sm whitespace-pre-wrap text-gray-700 dark:text-gray-300">@req.Message</p>
                @if (req.Kind == DialogKind.Prompt)
                {
                    <input class="input mt-3 w-full" aria-label="@req.Message" @bind="_input" @bind:event="oninput" @onkeydown="OnInputKeyDown" />
                }
                <div class="mt-5 flex justify-end gap-2">
                    <button type="button"
                            class="rounded-full px-4 py-1.5 text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition cursor-pointer"
                            @onclick="Cancel">
                        @L["common.cancel"]
                    </button>
                    <button type="button"
                            class="rounded-full px-4 py-1.5 text-sm font-medium transition cursor-pointer
                                   @(req.Danger
                                       ? "bg-red-600 text-white hover:bg-red-700"
                                       : "bg-gray-900 text-white hover:bg-gray-800 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200")"
                            @onclick="Accept">
                        @(req.Danger ? L["common.delete"] : L["common.ok"])
                    </button>
                </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private ElementReference _dialog;
    private ElementReference _linkInput;
    private string _input = "";
    private bool _copied;
    private DialogRequest? _rendered;

    protected override void OnInitialized()
    {
        Dialogs.Changed += OnDialogsChanged;
    }

    private void OnDialogsChanged()
    {
        // Reinicia o campo de texto a cada novo pedido de prompt.
        _input = Dialogs.Current?.DefaultValue ?? "";
        _copied = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task CopyLinkAsync()
    {
        if (Dialogs.Current?.DefaultValue is { } url)
        {
            try
            {
                await JS.InvokeVoidAsync(
                    "navigator.clipboard.writeText", url);
                _copied = true;
            }
            catch (JSException) { /* clipboard indisponível */ }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Dialogs.Current is { } req && !ReferenceEquals(req, _rendered))
        {
            _rendered = req;
            await JS.InvokeVoidAsync("ohn.trapFocus", _dialog);
            if (req.Kind == DialogKind.Link)
            {
                await JS.InvokeVoidAsync("ohn.selectAll", _linkInput);
            }
        }
        else if (Dialogs.Current is null && _rendered is not null)
        {
            _rendered = null;
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            Cancel();
        }
    }

    private void OnInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Accept();
        }
    }

    private void Accept()
    {
        if (Dialogs.Current?.Kind == DialogKind.Prompt)
        {
            Dialogs.Resolve(_input);
        }
        else
        {
            Dialogs.Resolve(true);
        }
    }

    private void Cancel() =>
        Dialogs.Resolve(Dialogs.Current?.Kind is DialogKind.Prompt ? null : false);

    public void Dispose() => Dialogs.Changed -= OnDialogsChanged;
}
