{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=data/openhandsnet.db"
  },
  "DeploymentMode": "oss",
  "Auth": {
    "Provider": "none"
  },
  "Observability": {
    "OtlpEndpoint": ""
  },
  "AllowedHosts": "*"
}
