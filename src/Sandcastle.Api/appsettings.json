{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=data/sandcastle.db"
  },
  "DeploymentMode": "oss",
  "Auth": {
    "Provider": "none"
  },
  "Observability": {
    "OtlpEndpoint": ""
  },
  "Browser": {
    "Enabled": true,
    "Headless": true,
    "NavigationTimeoutMs": 30000,
    "AutoInstall": true
  },
  "Billing": {
    "EnforcementEnabled": false
  },
  "Review": {
    "Enabled": true,
    "MaxFilesPerRun": 200,
    "MaxDiffKb": 512,
    "MaxInlineComments": 30,
    "MaxRulesChars": 8000,
    "MaxDailyRunsPerRepo": 50
  },
  "Autofix": {
    "Enabled": true,
    "MaxAttempts": 3,
    "MaxLogKb": 256,
    "PollSeconds": 60,
    "RunTimeoutMinutes": 45,
    "MaxDailyRunsPerRepo": 20
  },
  "AllowedHosts": "*",
  "Sandbox": {
    "Provider": "local"
  },
  "WebSearch": {
    "Endpoints": {
      "DuckDuckGo": "https://html.duckduckgo.com/html/",
      "Tavily": "https://api.tavily.com/search",
      "Brave": "https://api.search.brave.com/res/v1/web/search"
    }
  }
}