<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Sandbox engine layer (SPEC-35): docker engine impl + runtime-api client. No EF — container truth lives in Docker labels.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OpenHandsNET.Application/OpenHandsNET.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Docker.DotNet.Enhanced" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Ulid" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenHandsNET.IntegrationTests" />
    <InternalsVisibleTo Include="OpenHandsNET.UnitTests" />
  </ItemGroup>

</Project>
