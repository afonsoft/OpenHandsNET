# Sandcastle — exemplo de configuracao (copie para .env; NUNCA commite .env)
# Variaveis com prefixo SANDCASTLE_ mapeiam para secoes via "__"
# (SANDCASTLE_Database__Provider -> Database:Provider).
# Drift check: scripts/check-env-drift.sh compara com o codigo.

# --- Porta / hosting ---
SANDCASTLE_PORT=3032                  # porta externa do compose (app:8080 interno)
ASPNETCORE_ENVIRONMENT=Production

# --- Banco de dados ---
SANDCASTLE_Database__Provider=Sqlite  # Sqlite | PostgreSql
SANDCASTLE_Database__ConnectionString=Data Source=data/sandcastle.db
# PostgreSql (compose.postgres / enterprise):
# SANDCASTLE_Database__Provider=PostgreSql
# SANDCASTLE_Database__ConnectionString=Host=postgres;Database=sandcastle;Username=sandcastle;Password=${POSTGRES_PASSWORD}
POSTGRES_PASSWORD=CHANGE_ME

# --- Deployment ---
SANDCASTLE_DeploymentMode=oss         # oss | self_hosted | cloud
SANDCASTLE_MultiTenancy__Enabled=false

# --- LLM (SPEC-09; chaves flat legadas LLM__* tambem aceitas) ---
# SANDCASTLE_AgentLlm__Provider=openai        # openai | mock (dev/test only)
# SANDCASTLE_AgentLlm__Model=gpt-4o-mini
# SANDCASTLE_AgentLlm__BaseUrl=https://api.openai.com/v1
# SANDCASTLE_AgentLlm__ApiKey=sk-...          # NUNCA commite valor real
# SANDCASTLE_AgentLlm__MaxIterations=250
# SANDCASTLE_AgentLlm__ToolTimeoutSeconds=300
# SANDCASTLE_AgentLlm__ConfirmationTimeoutMinutes=10
# SANDCASTLE_AgentLlm__AllowMock=false        # mock fora de oss exige true
# LLM__MODEL= / LLM__BASE_URL= / LLM__API_KEY=  (aliases flat estilo upstream)

# --- Agent prompt (SPEC-90) ---
# SANDCASTLE_Agent__Sdd=auto   # auto (probe .specs//docs/specs) | on | off

# --- Sandbox (SPEC-03 + SPEC-14) ---
# SANDCASTLE_Sandbox__DefaultImage=ghcr.io/sandcastle/runtime:latest
#   → quickstart locale: `docker build -f runtime/Dockerfile -t
#   sandcastle/runtime:local .` e usa `sandcastle/runtime:local` —
#   senza l'immagine-agente non funzionano MCP chrome-devtools, tab
#   Desktop noVNC né surfaces (vscode/terminal).
# SANDCASTLE_Sandbox__ControlNetwork=        # rete docker condivisa app↔sandbox
#   (nome della rete del compose, es. sandcastle_default) — richiesta
#   dal surface proxy /sandboxes/{id}/surfaces/{port}/
# SANDCASTLE_Sandbox__WorkspaceRoot=data/workspaces
# SANDCASTLE_Sandbox__TimeoutMinutes=60
# SANDCASTLE_Sandbox__Profile=medium          # global default: small|medium|large
# SANDCASTLE_Sandbox__EnableDinD=false        # opt-in: privileged dind sidecar
# SANDCASTLE_Sandbox__DockerRuntime=          # SPEC-86: sysbox-runc p/ DinD sem sidecar privileged
# SANDCASTLE_Sandbox__DockerSocketMount=false # opt-in mais fraco que DinD
# Egress de sandbox: `unrestricted` é o default — para restringir veja
# docs/deployment/egress-allowlist.md
# SANDCASTLE_Sandbox__EgressMode=unrestricted # unrestricted|allowlist|deny
# SANDCASTLE_Sandbox__EgressAllow=api.github.com;*.internal.corp
# SANDCASTLE_Sandbox__WarmPoolSize=0          # N sandboxes pré-aquecidos (0=off)
# SANDCASTLE_Sandbox__WarmPoolImages=img:2;img2:1  # SPEC-17: pools extras por imagem
# SANDCASTLE_Sandbox__IdleSleepSeconds=30     # SPEC-16: graça pós-run → docker pause (-1=off)
# SANDCASTLE_Sandbox__SleepStopAfterHours=0   # SPEC-16: Paused>Nh → docker stop (0=off)
# SPEC-17 — runtime/agente in-container
# SANDCASTLE_Sandbox__AgentImagePrefixes=sandcastle/runtime  # imagens com agente HTTP (;)
# SANDCASTLE_Sandbox__PublishAgentPort=false  # publica :8000 em 127.0.0.1 (Docker Desktop)
# SANDCASTLE_Sandbox__BlueprintTimeoutMinutes=15  # timeout de sdk installers + setup.sh
# SANDCASTLE_Sandbox__Provider=local            # local | remote | kubernetes
# SANDCASTLE_Sandbox__RemoteEndpoint=http://runtime-api:8090  # provider=remote
# SANDCASTLE_Sandbox__RemoteApiKey=             # X-Runtime-Key do runtime-api

# ─── Web search (SPEC-133 — tool web_search) ──────────────────────────
# SANDCASTLE_WebSearch__Provider=duckduckgo   # duckduckgo|tavily|brave|none
# SANDCASTLE_WebSearch__ApiKey=               # exigido para tavily/brave
# SANDCASTLE_WebSearch__TimeoutSeconds=10
# SANDCASTLE_WebSearch__CacheSeconds=300
# SANDCASTLE_Sandbox__Kubernetes__Namespace=sandcastle-sandboxes
# SANDCASTLE_Sandbox__Kubernetes__KubeconfigPath=             # vazio = in-cluster
# SANDCASTLE_Sandbox__Kubernetes__RuntimeClassName=sysbox-runc
# SANDCASTLE_Sandbox__Kubernetes__WorkspacePvcSize=4Gi
# SANDCASTLE_Sandbox__RoutingMode=internal      # internal | path | host
# SANDCASTLE_Sandbox__PublicBaseDomain=         # ex.: sandboxes.example.com (host)
# --- Cache / backplane (SPEC-36) ---
# SANDCASTLE_Cache__Provider=memory             # memory | redis
# SANDCASTLE_Cache__Redis__ConnectionString=valkey:6379
# SANDCASTLE_Deployment__Replicas=1             # >1 habilita backplane distribuído
# --- Runtime API (SPEC-35, deployment split) ---
# SANDCASTLE_RuntimeApi__ApiKey=                # chave servida (vazio = fail-closed)
# DOCKER_HOST=unix:///var/run/docker.sock       # ou tcp://... (rootless)

# --- Billing / planos (SPEC-20) ---
# SANDCASTLE_Billing__EnforcementEnabled=false  # off = OSS nunca bloqueia;
# limites por plano via PUT/PATCH /api/v1/admin/plans (max_conversations_per_day,
# max_concurrent_runs, max_tokens_per_month, max_sandbox_seconds_per_month)

# --- Git (SPEC-12) ---
# SANDCASTLE_Git__CloneMode=container         # container | host
# SANDCASTLE_Git__WorkBranch=openhands/{id}
# SANDCASTLE_Git__AuthorName=Sandcastle
# SANDCASTLE_Git__AuthorEmail=agent@sandcastle.local

# --- Auth (SPEC-08) ---
# ATENÇÃO: `none` é single-user local — NÃO exponha à internet sem `oidc`.
# WARNING: `none` is single-user local — do NOT expose to the internet
# without `oidc` configured.
SANDCASTLE_Auth__Provider=none        # none | oidc
# SANDCASTLE_Auth__Authority=https://keycloak.example.com/realms/sandcastle
# SANDCASTLE_Auth__ClientId=sandcastle-web
# SANDCASTLE_Auth__ClientSecret=CHANGE_ME
# SANDCASTLE_Auth__UserProvisioningEnabled=false   # gate p/ POST /organizations/provision-user
# SANDCASTLE_Auth__EnableJwt=false                 # JWT bearer opcional (compat)
# SANDCASTLE_Auth__DeviceKeyExpirationDays=7       # device-flow sk-* TTL

# --- Rate limit global (SPEC-36) — 0 = desligado; o compose beta liga 120/min
# SANDCASTLE_RateLimit__RequestsPerMinute=0
# SANDCASTLE_RateLimit__ReadPerMinute=0
# SANDCASTLE_RateLimit__WritePerMinute=0
# SANDCASTLE_Auth__EnableSuperAdmin=false          # super-admin API em modo oss

# --- Webhooks outbound (SPEC-02) ---
# SANDCASTLE_Webhooks__Endpoints__0=https://example.com/hook
# SANDCASTLE_Webhooks__ConversationIds__0=<guid>  # vazio = todas

# --- Observabilidade (SPEC-13) ---
# SANDCASTLE_Observability__OtlpEndpoint=http://otel-collector:4317
# GRAFANA_ADMIN_PASSWORD=admin            # compose.observability
# KEYCLOAK_ADMIN_PASSWORD=admin           # compose.enterprise
# OPENAI_API_KEY=                         # LiteLLM gateway (compose.enterprise)
