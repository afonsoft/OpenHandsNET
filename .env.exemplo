# OpenHandsNET — exemplo de configuracao (copie para .env; NUNCA commite .env)
# Variaveis com prefixo OPENHANDSNET_ mapeiam para secoes via "__"
# (OPENHANDSNET_Database__Provider -> Database:Provider).
# Drift check: scripts/check-env-drift.sh compara com o codigo.

# --- Porta / hosting ---
OPENHANDSNET_PORT=3032                  # porta externa do compose (app:8080 interno)
ASPNETCORE_ENVIRONMENT=Production

# --- Banco de dados ---
OPENHANDSNET_Database__Provider=Sqlite  # Sqlite | PostgreSql
OPENHANDSNET_Database__ConnectionString=Data Source=data/openhandsnet.db
# PostgreSql (compose.postgres / enterprise):
# OPENHANDSNET_Database__Provider=PostgreSql
# OPENHANDSNET_Database__ConnectionString=Host=postgres;Database=openhandsnet;Username=openhandsnet;Password=${POSTGRES_PASSWORD}
POSTGRES_PASSWORD=CHANGE_ME

# --- Deployment ---
OPENHANDSNET_DeploymentMode=oss         # oss | self_hosted | cloud
OPENHANDSNET_MultiTenancy__Enabled=false

# --- LLM (SPEC-09; chaves flat legadas LLM__* tambem aceitas) ---
# OPENHANDSNET_AgentLlm__Provider=openai        # openai | mock (dev/test only)
# OPENHANDSNET_AgentLlm__Model=gpt-4o-mini
# OPENHANDSNET_AgentLlm__BaseUrl=https://api.openai.com/v1
# OPENHANDSNET_AgentLlm__ApiKey=sk-...          # NUNCA commite valor real
# OPENHANDSNET_AgentLlm__MaxIterations=250
# OPENHANDSNET_AgentLlm__ToolTimeoutSeconds=300
# OPENHANDSNET_AgentLlm__ConfirmationTimeoutMinutes=10
# OPENHANDSNET_AgentLlm__AllowMock=false        # mock fora de oss exige true
# LLM__MODEL= / LLM__BASE_URL= / LLM__API_KEY=  (aliases flat estilo upstream)

# --- Sandbox (SPEC-03 + SPEC-14) ---
# OPENHANDSNET_Sandbox__DefaultImage=ghcr.io/openhandsnet/runtime:latest
# OPENHANDSNET_Sandbox__WorkspaceRoot=data/workspaces
# OPENHANDSNET_Sandbox__TimeoutMinutes=60
# OPENHANDSNET_Sandbox__Profile=medium          # global default: small|medium|large
# OPENHANDSNET_Sandbox__EnableDinD=false        # opt-in: privileged dind sidecar
# OPENHANDSNET_Sandbox__DockerSocketMount=false # opt-in mais fraco que DinD
# OPENHANDSNET_Sandbox__EgressMode=unrestricted # unrestricted|allowlist|deny
# OPENHANDSNET_Sandbox__EgressAllow=api.github.com;*.internal.corp
# OPENHANDSNET_Sandbox__WarmPoolSize=0          # N sandboxes pré-aquecidos (0=off)
# OPENHANDSNET_Sandbox__IdleSleepSeconds=30     # SPEC-16: graça pós-run → docker pause (-1=off)
# OPENHANDSNET_Sandbox__SleepStopAfterHours=0   # SPEC-16: Paused>Nh → docker stop (0=off)
# DOCKER_HOST=unix:///var/run/docker.sock       # ou tcp://... (rootless)

# --- Git (SPEC-12) ---
# OPENHANDSNET_Git__CloneMode=container         # container | host
# OPENHANDSNET_Git__WorkBranch=openhands/{id}
# OPENHANDSNET_Git__AuthorName=OpenHandsNET
# OPENHANDSNET_Git__AuthorEmail=agent@openhandsnet.local

# --- Auth (SPEC-08) ---
OPENHANDSNET_Auth__Provider=none        # none | oidc
# OPENHANDSNET_Auth__Authority=https://keycloak.example.com/realms/openhandsnet
# OPENHANDSNET_Auth__ClientId=openhandsnet-web
# OPENHANDSNET_Auth__ClientSecret=CHANGE_ME
# OPENHANDSNET_Auth__UserProvisioningEnabled=false   # gate p/ POST /organizations/provision-user
# OPENHANDSNET_Auth__EnableJwt=false                 # JWT bearer opcional (compat)
# OPENHANDSNET_Auth__DeviceKeyExpirationDays=7       # device-flow sk-* TTL
# OPENHANDSNET_Auth__EnableSuperAdmin=false          # super-admin API em modo oss

# --- Webhooks outbound (SPEC-02) ---
# OPENHANDSNET_Webhooks__Endpoints__0=https://example.com/hook
# OPENHANDSNET_Webhooks__ConversationIds__0=<guid>  # vazio = todas

# --- Observabilidade (SPEC-13) ---
# OPENHANDSNET_Observability__OtlpEndpoint=http://otel-collector:4317
# GRAFANA_ADMIN_PASSWORD=admin            # compose.observability
# KEYCLOAK_ADMIN_PASSWORD=admin           # compose.enterprise
# OPENAI_API_KEY=                         # LiteLLM gateway (compose.enterprise)
