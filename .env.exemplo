# OpenHandsNET — exemplo de configuracao (copie para .env)
# Variaveis de ambiente com prefixo OPENHANDSNET_ mapeiam para secoes de
# configuracao via "__" (OPENHANDSNET_Database__Provider -> Database:Provider).

# Porta externa publicada pelo docker-compose (app escuta em 8080 interno)
OPENHANDSNET_PORT=3032

# Banco de dados: Sqlite (default) | PostgreSql
OPENHANDSNET_Database__Provider=Sqlite
OPENHANDSNET_Database__ConnectionString=Data Source=data/openhandsnet.db
# PostgreSql exemplo:
# OPENHANDSNET_Database__Provider=PostgreSql
# OPENHANDSNET_Database__ConnectionString=Host=postgres;Database=openhandsnet;Username=openhandsnet;Password=CHANGE_ME

# Modo de deployment: oss | self_hosted | cloud
OPENHANDSNET_DeploymentMode=oss

# Autenticacao (SPEC-08): none | oidc
OPENHANDSNET_Auth__Provider=none
# OPENHANDSNET_Auth__Authority=https://keycloak.example.com/realms/openhandsnet
# OPENHANDSNET_Auth__ClientId=openhandsnet-web

# Observabilidade: endpoint OTLP collector (vazio = desligado)
# OPENHANDSNET_Observability__OtlpEndpoint=http://otel-collector:4317

# ASP.NET
ASPNETCORE_ENVIRONMENT=Production
