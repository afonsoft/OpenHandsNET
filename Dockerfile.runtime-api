# Sandcastle runtime-api — SPEC-35 split deployment.
# Internal REST front of the sandbox engine (Docker.DotNet + warm pool).
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY Directory.Build.props Directory.Packages.props global.json nuget.config ./
COPY src/Sandcastle.Domain/Sandcastle.Domain.csproj src/Sandcastle.Domain/
COPY src/Sandcastle.Application/Sandcastle.Application.csproj src/Sandcastle.Application/
COPY src/Sandcastle.Sandboxing/Sandcastle.Sandboxing.csproj src/Sandcastle.Sandboxing/
COPY src/Sandcastle.RuntimeApi/Sandcastle.RuntimeApi.csproj src/Sandcastle.RuntimeApi/
RUN dotnet restore src/Sandcastle.RuntimeApi/Sandcastle.RuntimeApi.csproj

COPY src/ src/
RUN dotnet publish src/Sandcastle.RuntimeApi/Sandcastle.RuntimeApi.csproj \
      -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

# Precisa apenas do socket docker (montado em runtime) + curl p/ healthcheck.
ENV ASPNETCORE_URLS=http://+:8081 \
    ASPNETCORE_ENVIRONMENT=Production
RUN apt-get update && apt-get install -y --no-install-recommends curl && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    mkdir -p /data/workspaces && \
    groupadd -r sandcastle && useradd -r -g sandcastle sandcastle && \
    chown -R sandcastle:sandcastle /app

# NOTA: USER sandcastle omitido — o socket docker exige acesso ao grupo
# docker do host; deployments reais devem ajustar via group_add no compose.
EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS http://localhost:8081/healthz || exit 1

ENTRYPOINT ["dotnet", "Sandcastle.RuntimeApi.dll"]
